<Window x:Class="BigaFund.Views.QuickCalculatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIGA - 快速复利与定投试算器" 
        Height="580" Width="540"
        WindowStartupLocation="CenterOwner"
        Background="#181825" Foreground="#CDD6F4"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="🧮 快速复利与定投试算工具" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
            <TextBlock Text="测算初始本金与定期定投在不同年化收益率与投资年限下的财富复利效应" FontSize="12" Foreground="#6C7086" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Input & Output Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Parameters Card -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 初始本金 -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="初始投资本金 (元)" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPrincipal" Text="10000" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="8,6" TextChanged="Input_Changed"/>
                        </StackPanel>

                        <!-- 每期定投 -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="每期定投金额 (元)" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtPeriodic" Text="1000" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="8,6" TextChanged="Input_Changed"/>
                        </StackPanel>

                        <!-- 定投频率 -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,12">
                            <TextBlock Text="定投周期" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,4"/>
                            <ComboBox x:Name="CmbFrequency" SelectedIndex="0" Foreground="#FFFFFF" Padding="8,4" SelectionChanged="Input_Changed">
                                <ComboBoxItem Content="按月定投 (每年12期)"/>
                                <ComboBoxItem Content="按周定投 (每年52期)"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- 投资年限 -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,12">
                            <TextBlock Text="投资期限 (年)" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="TxtYears" Text="10" Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="8,6" TextChanged="Input_Changed"/>
                        </StackPanel>

                        <!-- 预期年化回报率 -->
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="预期年化复合收益率 (CAGR)" Foreground="#A6ADC8" FontSize="12" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="TxtReturnRateDisplay" Text="8.0%" Foreground="#F9E2AF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SliderReturnRate" Minimum="1" Maximum="30" Value="8" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Results Output Card -->
                <Border Background="#1E1E2E" CornerRadius="8" Padding="16" BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📊 复利试算结果" Foreground="#89B4FA" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Background="#313244" CornerRadius="6" Padding="12" Margin="0,0,6,6">
                                <StackPanel>
                                    <TextBlock Text="累计投入总本金" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtTotalCost" Text="¥ 130,000" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Background="#313244" CornerRadius="6" Padding="12" Margin="6,0,0,6">
                                <StackPanel>
                                    <TextBlock Text="期末总资产估值" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtFinalAsset" Text="¥ 205,821" FontSize="18" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Background="#313244" CornerRadius="6" Padding="12" Margin="0,6,6,0">
                                <StackPanel>
                                    <TextBlock Text="累计净利润 (复利赚取)" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtTotalProfit" Text="+¥ 75,821" FontSize="18" FontWeight="Bold" Foreground="#F38BA8" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Background="#313244" CornerRadius="6" Padding="12" Margin="6,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="累计收益率" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtReturnRatio" Text="+58.32%" FontSize="18" FontWeight="Bold" Foreground="#FAB387" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#252538" CornerRadius="6" Padding="12" Margin="0,4,0,0">
                            <TextBlock x:Name="TxtRule72Info" Text="💡 72 法则参考：在 8.0% 年化下，本金翻倍大约需要 9.0 年。" FontSize="11" Foreground="#BAC2DE" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Button Grid.Row="2" Content="关闭" Width="100" HorizontalAlignment="Right" Margin="0,16,0,0"
                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="0,6"
                Click="BtnClose_Click"/>
    </Grid>
</Window>
