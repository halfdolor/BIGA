                                            <TextBlock Text="{Binding ScoreCard.ResilienceScore, StringFormat='{}{0:F1}分', FallbackValue='--'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#89DCEB" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ScoreCard.ResilienceScore, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="5" Background="#313244" Foreground="#89DCEB" BorderThickness="0" Margin="0,1,0,4"/>

                                        <!-- 风格集中稳定 -->
                                        <Grid Margin="0,2">
                                            <TextBlock Text="🎯 风格集中稳定 (15%)" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBlock Text="{Binding ScoreCard.StabilityScore, StringFormat='{}{0:F1}分', FallbackValue='--'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#CBA6F7" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ScoreCard.StabilityScore, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="5" Background="#313244" Foreground="#CBA6F7" BorderThickness="0" Margin="0,1,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 右半侧: 核心亮点与风险提示 -->
                            <Grid Grid.Column="1" Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 核心亮点 Strengths -->
                                <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="10" Margin="0,0,0,3">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="💡 投研核心优势与亮点" FontSize="12" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,0,0,3"/>
