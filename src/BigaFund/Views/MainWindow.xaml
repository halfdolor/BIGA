<Window x:Class="BigaFund.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        xmlns:vm="clr-namespace:BigaFund.ViewModels"
        xmlns:views="clr-namespace:BigaFund.Views"
        mc:Ignorable="d"
        Title="BIGA" Height="880" Width="1380" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/app_icon.png"
        Background="#11111B" Foreground="#CDD6F4"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <!-- 全局快捷键绑定 -->
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenDatabaseFolderCommand}"/>
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding ToggleFavoriteCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCurrentFundCommand}"/>
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="0"/>
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="1"/>
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="2"/>
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="3"/>
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="4"/>
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="5"/>
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding SwitchMainTabCommand}" CommandParameter="6"/>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding OpenAiSimulationCommand}"/>
        <KeyBinding Key="M" Modifiers="Control" Command="{Binding OpenPortfolioCommand}"/>
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding OpenScreenerCommand}"/>
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding OpenCompareCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Control" Command="{Binding OpenSettingsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- 基础色彩系统 -->
        <SolidColorBrush x:Key="CardBackground" Color="#1E1E2E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#313244"/>
        <SolidColorBrush x:Key="PrimaryAccent" Color="#89B4FA"/>
        <SolidColorBrush x:Key="ProfitRed" Color="#F38BA8"/>
        <SolidColorBrush x:Key="LossGreen" Color="#A6E3A1"/>
        <SolidColorBrush x:Key="MutedText" Color="#A6ADC8"/>

        <!-- 覆盖系统菜单暗色调颜色 -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#181825"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#CDD6F4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#313244"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#89B4FA"/>

        <!-- 按钮样式 -->
        <Style x:Key="TimeBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TabBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#313244"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 卡片边框通用样式 -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,10,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. 顶部菜单栏 -->
            <RowDefinition Height="*"/>    <!-- 1. 工作台 Tab 容器 -->
            <RowDefinition Height="Auto"/> <!-- 2. 全局状态栏 -->
        </Grid.RowDefinitions>

        <!-- 0. 顶部专业菜单栏 -->
        <Border Grid.Row="0" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="4,2">
            <Menu Background="Transparent" Foreground="#FFFFFF" FontSize="12.5" FontWeight="SemiBold">
                <!-- 文件菜单 -->
                <MenuItem Header="文件 (F)" Padding="10,5">
                    <MenuItem Header="📂 打开 DuckDB 数据库目录" InputGestureText="Ctrl+O" Command="{Binding OpenDatabaseFolderCommand}"/>
                    <MenuItem Header="🗑️ 清空 DuckDB 数据库数据" Command="{Binding ClearDatabaseCommand}"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="📥 导出量化分析报表 (CSV)" InputGestureText="Ctrl+S" Command="{Binding ExportReportCommand}"/>
                    <MenuItem Header="📄 导出量化投研研报 (HTML / PDF)" InputGestureText="Ctrl+P" Command="{Binding ExportHtmlReportCommand}"/>
                    <MenuItem Header="📑 导出高管路演推介研报 (Pitch Deck)" InputGestureText="Ctrl+E" Command="{Binding ExportPitchDeckReportCommand}"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="❌ 退出系统" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
                </MenuItem>

                <!-- 视图菜单 -->
                <MenuItem Header="视图 (V)" Padding="10,5">
                    <MenuItem Header="📈 单基量化分析工作台" InputGestureText="Ctrl+1" Command="{Binding SwitchMainTabCommand}" CommandParameter="0"/>
                    <MenuItem Header="🔍 全市场多维选基工作台" InputGestureText="Ctrl+2" Command="{Binding SwitchMainTabCommand}" CommandParameter="1"/>
                    <MenuItem Header="🥊 基金多维对比 PK 擂台" InputGestureText="Ctrl+3" Command="{Binding SwitchMainTabCommand}" CommandParameter="2"/>
                    <MenuItem Header="🧩 组合资产配置与回测" InputGestureText="Ctrl+4" Command="{Binding SwitchMainTabCommand}" CommandParameter="3"/>
                    <MenuItem Header="🧮 快速复利与定投计算器" InputGestureText="Ctrl+5" Command="{Binding SwitchMainTabCommand}" CommandParameter="4"/>
                    <MenuItem Header="⚙️ 系统首选项与存储" InputGestureText="Ctrl+6" Command="{Binding SwitchMainTabCommand}" CommandParameter="5"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="📈 [单基] 累计收益走势 vs 沪深300" Command="{Binding SetChartTabCommand}" CommandParameter="0"/>
                    <MenuItem Header="💰 [单基] 定投策略资产与成本走势" Command="{Binding SetChartTabCommand}" CommandParameter="1"/>
                    <MenuItem Header="📉 [单基] 历史动态水下回撤走势" Command="{Binding SetChartTabCommand}" CommandParameter="2"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="🔄 强制从网络刷新当前基金" InputGestureText="F5" Command="{Binding RefreshCurrentFundCommand}"/>
                </MenuItem>

                <!-- 自选基金菜单 -->
                <MenuItem Header="自选 (B)" Padding="10,5">
                    <MenuItem Header="⭐ 将当前基金加入/移出自选" InputGestureText="Ctrl+D" Command="{Binding ToggleFavoriteCommand}"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="🗑️ 清空所有自选基金..." Command="{Binding ClearAllFavoritesCommand}"/>
                </MenuItem>

                <!-- 投资策略菜单 -->
                <MenuItem Header="投资策略 (S)" Padding="10,5">
                    <MenuItem Header="🟢 定期定额定投 (DCA)" Command="{Binding SetStrategyCommand}" CommandParameter="0"/>
                    <MenuItem Header="🟢 均线动态择时定投 (MA60 偏离度自适应)" Command="{Binding SetStrategyCommand}" CommandParameter="1"/>
                    <MenuItem Header="🟢 目标收益止盈定投 (+15% 自动锁定落袋)" Command="{Binding SetStrategyCommand}" CommandParameter="2"/>
                    <MenuItem Header="🟢 基金网格动态套利策略 (3% 价格网格)" Command="{Binding SetStrategyCommand}" CommandParameter="3"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="🟢 估值百分位智能定投 (滚动250日极值区间)" Command="{Binding SetStrategyCommand}" CommandParameter="4"/>
                    <MenuItem Header="🟢 股债 50:50 动态再平衡策略 (5%偏离度触发)" Command="{Binding SetStrategyCommand}" CommandParameter="5"/>
                </MenuItem>

                <!-- 量化工具菜单 -->
                <MenuItem Header="量化工具 (T)" Padding="10,5">
                    <MenuItem Header="🧩 基金组合资产配置与回测工作站" InputGestureText="Ctrl+M" Command="{Binding OpenPortfolioCommand}"/>
                    <MenuItem Header="🔍 全市场与自选池量化多维选基" InputGestureText="Ctrl+F" Command="{Binding OpenScreenerCommand}"/>
                    <MenuItem Header="🥊 基金多维对比与对标 PK 擂台" InputGestureText="Ctrl+P" Command="{Binding OpenCompareCommand}"/>
                    <MenuItem Header="🤖 AI 智能模拟操盘实战 (10万实操金)" InputGestureText="Ctrl+E" Command="{Binding OpenAiSimulationCommand}"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="📊 DuckDB 数据库运行状态与统计" Command="{Binding ShowDatabaseStatsCommand}"/>
                    <MenuItem Header="🌐 检查数据源服务器连通状态" Command="{Binding CheckDataHealthCommand}"/>
                    <MenuItem Header="🧮 快速复利与定投计算器" Command="{Binding OpenCalculatorCommand}"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="⚙️ 系统首选项与参数配置" InputGestureText="Ctrl+," Command="{Binding OpenSettingsCommand}"/>
                </MenuItem>

                <!-- 帮助菜单 -->
                <MenuItem Header="帮助 (H)" Padding="10,5">
                    <MenuItem Header="📖 核心量化风控指标释义说明" Command="{Binding ShowIndicatorHelpCommand}"/>
                    <Separator Background="#313244"/>
                    <MenuItem Header="ℹ️ 关于 BIGA..." Command="{Binding ShowAboutCommand}"/>
                </MenuItem>
            </Menu>
        </Border>

        <!-- 1. 工作台 Tab 容器 (单基/选基/对比/组合/试算/设置) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedMainTabIndex}" Margin="0,0,0,8">
            <!-- Tab 0: 📈 单基量化分析 -->
            <TabItem Header="📈 单基量化分析">
                <Grid Margin="0,6,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- 0. 搜索与自选栏 -->
                        <RowDefinition Height="Auto"/> <!-- 1. 基金概况卡片 -->
                        <RowDefinition Height="*"/>    <!-- 2. 走势图表区 -->
                        <RowDefinition Height="Auto"/> <!-- 3. 看板与策略回测 -->
                    </Grid.RowDefinitions>

                    <!-- 0. 顶部搜索与工具栏 -->
                    <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Image Source="/Assets/app_icon.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <TextBlock Text="BIGA" FontSize="22" FontWeight="Black" Foreground="#F5B041" VerticalAlignment="Center"/>
                    <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PRO" FontSize="10" FontWeight="Bold" Foreground="#F5B041"/>
                    </Border>
                </StackPanel>

                <!-- 搜索框 -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                             Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A"
                             FontSize="13" Padding="10,6" KeyDown="SearchBox_KeyDown"
                             VerticalContentAlignment="Center" CaretBrush="#CDD6F4">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <TextBlock Text="输入代码/拼音/名称 (回车搜索)" IsHitTestVisible="False"
                               VerticalAlignment="Center" Margin="12,0,0,0" Foreground="#585B70" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 搜索建议浮层 -->
                    <Popup IsOpen="{Binding IsSearchOpen}" PlacementTarget="{Binding ElementName=SearchBox}"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Slide">
                        <Border Width="400" MaxHeight="320" Background="#1E1E2E" BorderBrush="#45475A"
                                BorderThickness="1" CornerRadius="6" Margin="0,4,0,0">
                            <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0"
                                     MouseDoubleClick="SearchList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" BorderBrush="#313244" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" Margin="6,0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Type}" Foreground="#BAC2DE" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="⭐ 收藏"
                                                        Tag="{Binding}" Click="BtnQuickAddFavorite_Click"
                                                        Style="{StaticResource TimeBtnStyle}" Background="#252636" Foreground="#F5B041"
                                                        FontSize="11" Padding="6,2" Cursor="Hand" ToolTip="一键将此基金保存至自选池"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="2" Content="搜索" Command="{Binding SearchCommand}"
                        Style="{StaticResource TimeBtnStyle}" Background="#89B4FA" Foreground="#11111B"
                        Margin="8,0,16,0" Padding="14,6"/>

                <!-- 热门精选与用户自选快捷标签 (隐藏原生滚动条，支持滚轮与右侧箭头平滑滚动) -->
                <Grid Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" x:Name="FavoritesScrollViewer"
                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  Focusable="False" PreviewMouseWheel="FavoritesScrollViewer_PreviewMouseWheel"
                                  ScrollChanged="FavoritesScrollViewer_ScrollChanged">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="板块:" Foreground="#F5B041" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <ComboBox ItemsSource="{Binding SectorCategories}" SelectedItem="{Binding SelectedSector, Mode=TwoWay}"
                                      Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" FontSize="11" Width="92" Margin="0,0,6,0"
                                      VerticalContentAlignment="Center"/>
                            <Button Content="选基" Command="{Binding OpenScreenerWithSectorCommand}" ToolTip="按此板块进入多维选基大厅"
                                    Style="{StaticResource TimeBtnStyle}" Background="#313244" Foreground="#89B4FA" FontSize="11" Margin="0,0,8,0" Padding="6,3"/>

                            <TextBlock Text="精选:" Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ItemsControl ItemsSource="{Binding QuickPicks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayText}" Style="{StaticResource TimeBtnStyle}"
                                                Foreground="#FFFFFF" FontSize="11" Margin="2,0" Click="QuickPick_Click"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Width="1" Height="16" Background="#45475A" Margin="8,0"/>

                            <TextBlock Text="自选:" Foreground="#F5B041" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <!-- 暂无自选提示 -->
                            <TextBlock Text="(暂无自选，搜索或在下方点击⭐快速保存)" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasFavorites}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- 自选基金芯片列表 -->
                            <ItemsControl ItemsSource="{Binding Favorites}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#252636" BorderBrush="#F5B041" BorderThickness="1" CornerRadius="4" Margin="3,0" Padding="6,2">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding DisplayText}"
                                                        Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                                        FontSize="11" FontWeight="SemiBold" Cursor="Hand" Click="Favorite_Click" Padding="0"/>
                                                <Button Content="✕" Margin="6,0,0,0"
                                                        Background="Transparent" BorderThickness="0" Foreground="#A6ADC8"
                                                        FontSize="10" Cursor="Hand" ToolTip="从自选移除"
                                                        Tag="{Binding Code}" Click="BtnRemoveFavorite_Click" Padding="2,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 右侧横向翻页箭头按钮组 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                        <Button x:Name="BtnScrollLeft" Content="◀" Click="BtnScrollFavoritesLeft_Click"
                                Style="{StaticResource TimeBtnStyle}" Background="#252636" Foreground="#CDD6F4"
                                FontSize="10" Padding="8,4" Margin="1,0" ToolTip="向左滚动查看"/>
                        <Button x:Name="BtnScrollRight" Content="▶" Click="BtnScrollFavoritesRight_Click"
                                Style="{StaticResource TimeBtnStyle}" Background="#252636" Foreground="#89B4FA"
                                FontSize="10" Padding="8,4" Margin="1,0" ToolTip="向右滚动查看更多"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 1. 基金概况与时间区间选择 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 0. 基金核心名片与高光评级 -->
                    <RowDefinition Height="Auto"/> <!-- 1. 基金核心指标参数条 -->
                    <RowDefinition Height="Auto"/> <!-- 2. 统计区间选择与报表导出独立工具栏 -->
                </Grid.RowDefinitions>

                <!-- 0. 基金核心名片与高光评级 -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 基金核心名片 (名称、代码、类型、风格箱、自选) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentFund.Name, FallbackValue='请在上方搜索或选择基金'}"
                                   FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFund.Code, FallbackValue='000000'}" FontSize="12.5" Foreground="#89B4FA" FontWeight="Bold"/>
                        </Border>
                        <Border Background="#45475A" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentFund.Type, FallbackValue='公募基金'}" FontSize="11" Foreground="#FFFFFF"/>
                        </Border>
                        <Border Background="#1E3A5F" BorderBrush="#3A7BD5" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="晨星九宫格风格箱 (大/中/小盘 × 价值/平衡/成长)">
                            <TextBlock Text="{Binding CurrentFund.StyleBoxName, FallbackValue='大盘平衡'}" FontSize="11" Foreground="#89B4FA" FontWeight="SemiBold"/>
                        </Border>

                        <!-- 极速加自选 / 移出自选 显眼高对比按钮 -->
                        <Button Command="{Binding ToggleFavoriteCommand}" Margin="10,0,0,0" Padding="10,3"
                                Cursor="Hand" ToolTip="点击快速保存至自选池，或从自选池移除">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="#252636"/>
                                    <Setter Property="BorderBrush" Value="#F5B041"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontSize" Value="11.5"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Content" Value="⭐ 加入自选"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                 <Border Background="{TemplateBinding Background}"
                                                         BorderBrush="{TemplateBinding BorderBrush}"
                                                         BorderThickness="{TemplateBinding BorderThickness}"
                                                         CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                 </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#353648"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsCurrentFavorite}" Value="True">
                                            <Setter Property="Content" Value="★ 已在自选池 (点击移出)"/>
                                            <Setter Property="Background" Value="#F5B041"/>
                                            <Setter Property="Foreground" Value="#11111B"/>
                                            <Setter Property="BorderBrush" Value="#F5B041"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- 🎯 AI 模拟买入快捷按钮 -->
                        <Button Command="{Binding SimulateBuyCurrentFundCommand}" Margin="8,0,0,0" Padding="10,3"
                                Background="#89B4FA" Foreground="#11111B" BorderBrush="#89B4FA" FontWeight="Bold" FontSize="11.5"
                                Cursor="Hand" ToolTip="将当前基金带入 AI 模拟操盘中心进行模拟建仓买入">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                            <Button.Content>
                                <TextBlock Text="🎯 模拟买入"/>
                            </Button.Content>
                        </Button>
                    </StackPanel>

                    <!-- 右侧：⚡ 盘中实时估算净值 + 🏆 综合评分 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ⚡ 盘中实时估算净值 -->
                        <Border Background="#181825" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                ToolTip="{Binding RealtimeValuation.ValuationTime, StringFormat='估值更新时间: {0}'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ 盘中估算: " Foreground="#89B4FA" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RealtimeValuation.EstimatedNav, StringFormat='{}{0:F4}', FallbackValue='--'}"
                                           FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                <TextBlock Text="{Binding RealtimeValuation.EstimatedGrowthRate, StringFormat='{}{0:+0.00;-0.00;0.00}%', FallbackValue='--'}"
                                           FontWeight="Bold" FontSize="11" Foreground="#F38BA8"/>
                            </StackPanel>
                        </Border>

                        <!-- 🏆 量化评级与打分 -->
                        <Border Background="#25211B" BorderBrush="#F5B041" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                ToolTip="机构级五维量化综合打分模型 (收益/风控/风险调整/极端抗跌/风格稳定性)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏆 综合评分: " Foreground="#F5B041" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScoreCard.OverallScore, StringFormat='{}{0:F1}分', FallbackValue='--'}"
                                           FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                <Border Background="#F5B041" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScoreCard.RatingGrade, FallbackValue='--'}"
                                               FontSize="10.5" FontWeight="Bold" Foreground="#11111B"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- 🚀 科学投资建议决议 (Phase 15) -->
                        <Border Background="#1C2333" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                ToolTip="{Binding ScientificAdvice.ExecutiveAdvisoryVerdict, FallbackValue='全闭环科学投资建议引擎'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🚀 投资决议: " Foreground="#3B82F6" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding ScientificAdvice.ActionSignalText, FallbackValue='--'}"
                                           FontWeight="Bold" FontSize="11" Foreground="#FFFFFF" Margin="0,0,4,0"/>
                                <Border Background="#3B82F6" CornerRadius="3" Padding="4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ScientificAdvice.ConvictionScore, StringFormat='置信度 {0:F0}%', FallbackValue='--'}"
                                               FontSize="10.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- 1. 基金核心指标参数条 (净值、经理、任期、规模、CR10、当前回撤) -->
                <Border Grid.Row="1" Margin="0,6,0,0" Padding="0,4,0,0" BorderBrush="#252636" BorderThickness="0,1,0,0">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="最新净值: " Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding CurrentFund.LatestUnitNav, StringFormat='{}{0:F4}', FallbackValue='--'}"
                                       FontWeight="Bold" Foreground="#89B4FA"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="经理: " Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding CurrentFund.ManagerName, FallbackValue='--'}" Foreground="#CDD6F4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="任职时间: " Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding CurrentFund.ManagerTenure, FallbackValue='--'}" Foreground="#CDD6F4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="规模: " Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding CurrentFund.FundSize, FallbackValue='--'}" Foreground="#CDD6F4"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="集中度(CR10): " Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding CurrentFund.HoldingsCr10, StringFormat='{}{0:F1}%', FallbackValue='--'}" Foreground="#F5B041" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                            <TextBlock Text="当前回撤: " Foreground="{StaticResource MutedText}"/>
                            <TextBlock Text="{Binding Metrics.CurrentDrawdown, StringFormat='-{0:F2}%', FallbackValue='--'}" Foreground="#A6E3A1" FontWeight="SemiBold"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>

                <!-- 2. 统计区间选择与报表导出独立工具栏 (独占一行，绝不挤压裁切) -->
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="10,6" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左侧：统计区间时间切换 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="统计区间: " Foreground="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                            <Button Content="近1月" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="1M" Padding="10,4" Margin="2,0"/>
                            <Button Content="近3月" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="3M" Padding="10,4" Margin="2,0"/>
                            <Button Content="近6月" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="6M" Padding="10,4" Margin="2,0"/>
                            <Button Content="近1年" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="1Y" Padding="10,4" Margin="2,0"/>
                            <Button Content="近3年" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="3Y" Padding="10,4" Margin="2,0"/>
                            <Button Content="近5年" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="5Y" Padding="10,4" Margin="2,0"/>
                            <Button Content="成立来" Style="{StaticResource TimeBtnStyle}" Command="{Binding SetTimeRangeCommand}" CommandParameter="ALL" Padding="10,4" Margin="2,0"/>
                        </StackPanel>

                        <!-- 右侧：报表导出动作按钮组 -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📥 导出CSV" Style="{StaticResource TimeBtnStyle}"
                                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold"
                                    Command="{Binding ExportReportCommand}" Margin="4,0" Padding="12,5"
                                    ToolTip="导出当前基金全套量化指标、策略回测现金流与历史净值到 CSV"/>

                            <Button Content="📄 导出研报" Style="{StaticResource TimeBtnStyle}"
                                    Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"
                                    Command="{Binding ExportHtmlReportCommand}" Margin="4,0" Padding="12,5"
                                    ToolTip="导出为专业机构级富文本 HTML 研报 (支持浏览器查阅与另存为打印级 PDF)"/>

                            <Button Content="📑 路演Deck" Style="{StaticResource TimeBtnStyle}"
                                    Background="#F5B041" Foreground="#11111B" FontWeight="Bold"
                                    Command="{Binding ExportPitchDeckReportCommand}" Margin="4,0" Padding="12,5"
                                    ToolTip="导出为投资决策委员会 360° 全景高管路演研报 (Executive Pitch Deck HTML)"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 2. 图表可视化主区 (ScottPlot) -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Padding="0" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 图表模式切换 Tab 与 动态 HUD 读数看板 -->
                <Border Background="#181825" BorderBrush="#313244" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📈 累计收益走势 (对比沪深300基准)" Style="{StaticResource TabBtnStyle}"
                                    Command="{Binding SetChartTabCommand}" CommandParameter="0"/>
                            <Button Content="💰 定投策略回测 (总资产 vs 累计本金)" Style="{StaticResource TabBtnStyle}"
                                    Command="{Binding SetChartTabCommand}" CommandParameter="1"/>
                            <Button Content="📉 历史回撤水下走势 (Drawdown)" Style="{StaticResource TabBtnStyle}"
                                    Command="{Binding SetChartTabCommand}" CommandParameter="2"/>
                            <Button Content="⚡ 滚动风控走势 (波动率 &amp; 夏普)" Style="{StaticResource TabBtnStyle}"
                                    Command="{Binding SetChartTabCommand}" CommandParameter="3"/>
                            <Button Content="🔮 前瞻模拟预测锥 (GARCH Fan &amp; Reality)" Style="{StaticResource TabBtnStyle}"
                                    Command="{Binding SetChartTabCommand}" CommandParameter="4"
                                    ToolTip="基于 GARCH 厚尾分位数模拟未来 60 交易日预测锥 (P10/P50/P90) 与事后现实检验"/>
                        </StackPanel>

                        <!-- 金融级十字准星动态时序读数看板 (HUD) -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" 
                                Background="#11111B" BorderBrush="#45475A" BorderThickness="1" CornerRadius="4" Padding="10,4" Margin="0,0,4,0">
                            <TextBlock x:Name="TxtPlotHud" Text="💡 移动鼠标至图表区域可交互读取时序精准数据" 
                                       Foreground="#A6ADC8" FontSize="11" FontFamily="Consolas, Microsoft YaHei UI"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ScottPlot 控件 -->
                <sp:WpfPlot x:Name="MainPlot" Grid.Row="1"/>
            </Grid>
        </Border>

        <!-- 3. 底部面板：量化指标看板 + 定投回测结算 -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- 左侧量化指标 -->
                <ColumnDefinition Width="2*"/> <!-- 右侧定投策略参数与结果 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧：机构级量化投研综合诊断控制台 (4-Tab) -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Background" Value="#181825"/>
                            <Setter Property="Foreground" Value="#A6ADC8"/>
                            <Setter Property="Padding" Value="12,6"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="#313244"/>
                                                <Setter Property="Foreground" Value="#F5B041"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.Resources>

                    <!-- Tab 1: 核心量化风控指标 (原有 6 大经典卡片) -->
                    <TabItem Header="📊 核心风控指标">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                                <TextBlock Text="量化风控核心指标" FontSize="13" FontWeight="Bold" Foreground="#89B4FA"/>
                                <TextBlock Text="{Binding Metrics.PeriodName, StringFormat=' (统计区间: {0})', FallbackValue=''}"
                                           Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Metrics.TradingDays, StringFormat='，共 {0} 个交易日', FallbackValue=''}"
                                           Foreground="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="4" Rows="2">
                                <!-- 卡片 1: 区间累计 / 年化复合收益率 (CAGR) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="年化复合收益率 (CAGR)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                        <TextBlock Text="{Binding Metrics.AnnualizedReturn, StringFormat='{}{0:+0.00;-0.00;0.00}%', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#F38BA8" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Metrics.TotalReturn, StringFormat='区间总收益: {0:+0.00;-0.00;0.00}%', FallbackValue='--'}"
                                                   FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 2: 最大回撤 (MDD) & 修复天数 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="历史最大回撤 (MDD)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                        <TextBlock Text="{Binding Metrics.MaxDrawdown, StringFormat='{}{0:F2}%', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="{Binding Metrics.MaxDrawdownTroughDate, Mode=OneWay, StringFormat='谷底: {0:yyyy-MM-dd}', FallbackValue='--'}"/>
                                            <Run Text=" | 修复: "/>
                                            <Run Text="{Binding Metrics.RecoveryTradingDays, Mode=OneWay, StringFormat='{}{0}日', FallbackValue='未修复'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 3: 夏普比率 (Sharpe) & 特雷诺比率 (Treynor) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="夏普比率 (Sharpe, Rf=2%)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBlock Text="{Binding Metrics.TreynorRatio, StringFormat='特雷诺: {0:F2}', FallbackValue=''}"
                                                       Foreground="#F5B041" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Metrics.SharpeRatio, StringFormat='{}{0:F2}', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#FAB387" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="承担单位总风险超额回报"/>
                                            <Run Text=" | 跟踪误差: "/>
                                            <Run Text="{Binding Metrics.TrackingError, Mode=OneWay, StringFormat='{}{0:F2}%', FallbackValue='--'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 4: 年化波动率 (Volatility) & 机构捕获比率 (Capture) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="年化波动率 (Volatility)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBlock Text="{Binding Metrics.CaptureRatio, StringFormat='捕获比: {0:F2}', FallbackValue=''}"
                                                       Foreground="#A6E3A1" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Metrics.AnnualizedVolatility, StringFormat='{}{0:F2}%', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#CDD6F4" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="上行UCR: "/>
                                            <Run Text="{Binding Metrics.UpsideCaptureRatio, Mode=OneWay, StringFormat='{}{0:F0}%', FallbackValue='--'}"/>
                                            <Run Text=" | 下行DCR: "/>
                                            <Run Text="{Binding Metrics.DownsideCaptureRatio, Mode=OneWay, StringFormat='{}{0:F0}%', FallbackValue='--'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 5: 卡玛比率 (Calmar) & 索提诺比率 (Sortino) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="卡玛比率 (Calmar)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBlock Text="{Binding Metrics.SortinoRatio, StringFormat='索提诺: {0:F2}', FallbackValue=''}"
                                                       Foreground="#CBA6F7" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Metrics.CalmarRatio, StringFormat='{}{0:F2}', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#89DCEB" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="年化/最大回撤"/>
                                            <Run Text=" | Omega: "/>
                                            <Run Text="{Binding Metrics.OmegaRatio, Mode=OneWay, StringFormat='{}{0:F2}', FallbackValue='--'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 6: CAPM 资本资产定价模型 (Alpha / Beta / IR) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="CAPM 超额模型" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBlock Text="{Binding Metrics.Beta, StringFormat='Beta: {0:F2}', FallbackValue='Beta: --'}"
                                                       Foreground="#BAC2DE" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Metrics.Alpha, StringFormat='{}{0:+0.00;-0.00;0.00}%', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="Alpha超额"/>
                                            <Run Text=" | UI: "/>
                                            <Run Text="{Binding Metrics.UlcerIndex, Mode=OneWay, StringFormat='{}{0:F1}%', FallbackValue='--'}"/>
                                            <Run Text=" | Martin: "/>
                                            <Run Text="{Binding Metrics.MartinRatio, Mode=OneWay, StringFormat='{}{0:F2}', FallbackValue='--'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 7: 修正 Cornish-Fisher 极端在险价值 (mVaR / mCVaR) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="95% 极端在险价值 (mVaR/mCVaR)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBlock Text="{Binding Metrics.TailRisk.TailFatnessRating, FallbackValue=''}"
                                                       Foreground="#F38BA8" FontSize="11" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                        </Grid>
                                        <TextBlock Foreground="#F38BA8" Margin="0,4,0,0" FontSize="18" FontWeight="Bold">
                                            <Run Text="{Binding Metrics.CornishFisherVaR95, Mode=OneWay, StringFormat='{}{0:F2}%', FallbackValue='--'}"/>
                                            <Run Text=" / "/>
                                            <Run Text="{Binding Metrics.CornishFisherCVaR95, Mode=OneWay, StringFormat='{}{0:F2}%', FallbackValue='--'}"/>
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="偏度: "/>
                                            <Run Text="{Binding Metrics.Skewness, Mode=OneWay, StringFormat='{}{0:+0.00;-0.00;0.00}', FallbackValue='--'}"/>
                                            <Run Text=" | 峰度: "/>
                                            <Run Text="{Binding Metrics.ExcessKurtosis, Mode=OneWay, StringFormat='{}{0:+0.00;-0.00;0.00}', FallbackValue='--'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- 卡片 8: 巴塞尔协议监管风险与极端压力指标 (Basel 10-day VaR) -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="巴塞尔监管在险 (10日99% VaR)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                            <TextBlock Text="Basel III 规范" Foreground="#89B4FA" FontSize="11" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Metrics.TailRisk.Basel10DayVaR99, StringFormat='{}{0:F2}%', FallbackValue='--'}"
                                                   FontSize="20" FontWeight="Bold" Foreground="#FAB387" Margin="0,4,0,0"/>
                                        <TextBlock Foreground="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0">
                                            <Run Text="99% mVaR: "/>
                                            <Run Text="{Binding Metrics.TailRisk.CornishFisherVaR99, Mode=OneWay, StringFormat='{}{0:F2}%', FallbackValue='--'}"/>
                                            <Run Text=" | mCVaR: "/>
                                            <Run Text="{Binding Metrics.TailRisk.CornishFisherCVaR99, Mode=OneWay, StringFormat='{}{0:F2}%', FallbackValue='--'}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: 🏆 五维量化评价卡 -->
