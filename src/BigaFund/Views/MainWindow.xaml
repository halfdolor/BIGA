                                            <TextBlock Text="📈 收益获取能力 (25%)" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBlock Text="{Binding ScoreCard.ReturnScore, StringFormat='{}{0:F1}分', FallbackValue='--'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#F38BA8" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ScoreCard.ReturnScore, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="5" Background="#313244" Foreground="#F38BA8" BorderThickness="0" Margin="0,1,0,4"/>

                                        <!-- 回撤风控维度 -->
                                        <Grid Margin="0,2">
                                            <TextBlock Text="🛡️ 风控回撤能力 (20%)" FontSize="11" Foreground="#A6ADC8"/>
                                            <TextBlock Text="{Binding ScoreCard.RiskControlScore, StringFormat='{}{0:F1}分', FallbackValue='--'}"
                                                       FontSize="11" FontWeight="Bold" Foreground="#A6E3A1" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding ScoreCard.RiskControlScore, Mode=OneWay, FallbackValue=0}" Maximum="100" Height="5" Background="#313244" Foreground="#A6E3A1" BorderThickness="0" Margin="0,1,0,4"/>

                                        <!-- 风险调整收益 -->
