                                    <DataGridTextColumn Header="选股效应" Binding="{Binding SelectionEffect, StringFormat='{}{0:+0.00;-0.00;0.00}%'}" Width="65">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A6E3A1"/>
                                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                                <Setter Property="Padding" Value="4,3"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="交互效应" Binding="{Binding InteractionEffect, StringFormat='{}{0:+0.00;-0.00;0.00}%'}" Width="65">
