                    <!-- Tab 6: 📉 历史最深回撤解构 (Top 5 Drawdown Episodes) -->
                    <TabItem Header="📉 深度回撤解构">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="4,0,0,6">
                                <TextBlock Text="历史前五大最深回撤周期解构" FontSize="13" FontWeight="Bold" Foreground="#89B4FA"/>
                                <TextBlock Text=" (峰值-谷底-出坑修复全周期追踪)" Foreground="#BAC2DE" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 顶行非正态下行风控与全历史水下套牢深度解构 KPI 卡片 -->
                            <UniformGrid Grid.Row="1" Columns="4" Rows="2" Margin="0,0,0,6">
                                <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="奥米加比率 (Omega)" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
                                        <TextBlock Text="{Binding Metrics.OmegaRatio, StringFormat='{}{0:F2}', FallbackValue='--'}" FontSize="16" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,2,0,0"/>
                                        <TextBlock Text="全收益分布胜率质量比" Foreground="#BAC2DE" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="溃疡指数 (Ulcer UI)" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
                                        <TextBlock Text="{Binding Metrics.UlcerIndex, StringFormat='{}{0:F2}%', FallbackValue='--'}" FontSize="16" FontWeight="Bold" Foreground="#FAB387" Margin="0,2,0,0"/>
                                        <TextBlock Text="回撤深度与水下方根" Foreground="#BAC2DE" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="马丁比率 (Martin)" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
                                        <TextBlock Text="{Binding Metrics.MartinRatio, StringFormat='{}{0:F2}', FallbackValue='--'}" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,2,0,0"/>
                                        <TextBlock Text="超额收益 / 溃疡指数" Foreground="#BAC2DE" FontSize="10"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                    <StackPanel>
                                        <TextBlock Text="收益痛苦比 / 下行标准差" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
                                        <TextBlock Foreground="#F38BA8" Margin="0,2,0,0" FontSize="15" FontWeight="Bold">
                                            <Run Text="{Binding Metrics.PainRatio, Mode=OneWay, StringFormat='{}{0:F2}', FallbackValue='--'}"/>
                                            <Run Text=" / "/>
