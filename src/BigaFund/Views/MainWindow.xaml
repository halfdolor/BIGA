                                                        <Run Text="{Binding AlphaPersistence.RollingWinRate3M, StringFormat='{}{0:F0}%'}" />
                                                    </TextBlock>
                                                    <TextBlock Text="中短周期超额胜率" Foreground="#BAC2DE" FontSize="10"/>
