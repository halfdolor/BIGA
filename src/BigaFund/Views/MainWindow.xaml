                                            <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="最长连续跑赢月数" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
