                                                               FontSize="15" FontWeight="Bold" Foreground="#F5B041" Margin="0,2,0,0"/>
                                                    <TextBlock Text="胜势连击韧性" Foreground="#BAC2DE" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="年化跟踪误差 / IR" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
                                                    <TextBlock Foreground="#CBA6F7" FontSize="14" FontWeight="Bold" Margin="0,2,0,0">
                                                        <Run Text="{Binding AlphaPersistence.ActiveRisk, StringFormat='{}{0:F1}%'}" />
                                                        <Run Text=" | " />
                                                        <Run Text="{Binding AlphaPersistence.InformationRatio, StringFormat='IR {0:F2}'}" />
                                                    </TextBlock>
                                                    <TextBlock Text="主动风险与信息比率" Foreground="#BAC2DE" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#181825" CornerRadius="6" Padding="8,6" Margin="2">
                                                <StackPanel>
                                                    <TextBlock Text="超额收益衰减斜率" Foreground="{StaticResource MutedText}" FontSize="10.5"/>
                                                    <TextBlock Text="{Binding AlphaPersistence.AlphaDecayRate, StringFormat='{}{0:+0.000;-0.000;0.000}%/月', FallbackValue='--'}" 
                                                               FontSize="14" FontWeight="Bold" Foreground="#BAC2DE" Margin="0,2,0,0"/>
                                                    <TextBlock Text="Alpha衰减时效研判" Foreground="#BAC2DE" FontSize="10"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Background="#181825" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding AlphaPersistence.InstitutionalVerdict, FallbackValue='阿尔法持续性测算中...'}"
                                                       FontSize="11" Foreground="#BAC2DE" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 板块 3: 多因子预测效力 IC / IR 检验与衰减周期 (Factor IC/IR & Decay Horizon) -->
                                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="🔬 多因子预测效力 IC / IR 检验与衰减周期分析 (Factor Horizon)" FontSize="14" FontWeight="Bold" Foreground="#A6E3A1"/>
                                                <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock Text="Rank IC (Spearman) + Normal IC + 衰减时效" FontSize="10" Foreground="#F9E2AF"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="核心Alpha因子: " Foreground="{StaticResource MutedText}" FontSize="11"/>
                                                <TextBlock Text="{Binding FactorIcAnalysis.DominantAlphaFactor, FallbackValue='--'}" FontWeight="Bold" Foreground="#F5B041" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 因子效力数据表 -->
                                        <DataGrid ItemsSource="{Binding FactorIcAnalysis.Factors}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                  RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#313244" VerticalGridLinesBrush="#313244"
                                                  HeadersVisibility="Column" FontSize="11" Margin="0,0,0,8">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#252636"/>
                                                    <Setter Property="Foreground" Value="#A6E3A1"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="BorderBrush" Value="#313244"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="因子名称" Binding="{Binding FactorDisplayName}" Width="160"/>
                                                <DataGridTextColumn Header="Rank IC (均值)" Binding="{Binding MeanRankIc, StringFormat='{}{0:+0.000;-0.000;0.000}'}" Width="100"/>
                                                <DataGridTextColumn Header="Normal IC" Binding="{Binding MeanNormalIc, StringFormat='{}{0:+0.000;-0.000;0.000}'}" Width="90"/>
                                                <DataGridTextColumn Header="IC 标准差" Binding="{Binding IcStdDev, StringFormat='{}{0:F3}'}" Width="85"/>
                                                <DataGridTextColumn Header="IC_IR (信息比)" Binding="{Binding IcInformationRatio, StringFormat='{}{0:F2}'}" Width="95"/>
                                                <DataGridTextColumn Header="方向一致率" Binding="{Binding DirectionalConsistency, StringFormat='{}{0:F1}%'}" Width="85"/>
                                                <DataGridTextColumn Header="效力研判结论" Binding="{Binding PredictiveStrength}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Background="#181825" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding FactorIcAnalysis.InstitutionalRecommendation, FallbackValue='多因子 IC/IR 效力检验就绪。'}"
                                                       FontSize="11" Foreground="#BAC2DE" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 板块 4: Phase 18 因子拥挤度与估值差离散度监测 (Factor Crowding & Valuation Dispersion) -->
                                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚡ 风格因子拥挤度与估值差离散度监测 (Factor Crowding &amp; Dispersion)" FontSize="14" FontWeight="Bold" Foreground="#F5B041"/>
                                                <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                                    <TextBlock Text="有效因子维度 Neff + 估值 Spread 分位数 + 拥挤度告警" FontSize="10" Foreground="#89B4FA"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="有效因子维度: " Foreground="{StaticResource MutedText}" FontSize="11"/>
                                                <TextBlock Text="{Binding FactorCrowding.EffectiveFactorDimension, StringFormat='{}{0:F1}', FallbackValue='--'}" FontWeight="Bold" Foreground="#A6E3A1" FontSize="11" Margin="0,0,10,0"/>
                                                <TextBlock Text="最拥挤风格: " Foreground="{StaticResource MutedText}" FontSize="11"/>
                                                <TextBlock Text="{Binding FactorCrowding.DominantCrowdedFactor, FallbackValue='--'}" FontWeight="Bold" Foreground="#F38BA8" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- 因子拥挤度与离散度指标数据表 -->
                                        <DataGrid ItemsSource="{Binding FactorCrowding.Factors}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                                                  Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                  RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                                                  GridLinesVisibility="All" HorizontalGridLinesBrush="#313244" VerticalGridLinesBrush="#313244"
                                                  HeadersVisibility="Column" FontSize="11" Margin="0,0,0,8">
                                            <DataGrid.ColumnHeaderStyle>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="#252636"/>
                                                    <Setter Property="Foreground" Value="#F5B041"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="BorderBrush" Value="#313244"/>
                                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                                </Style>
                                            </DataGrid.ColumnHeaderStyle>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="风格因子" Binding="{Binding FactorDisplayName}" Width="150"/>
                                                <DataGridTextColumn Header="估值差(Spread)" Binding="{Binding ValuationSpread, StringFormat='{}{0:F2}'}" Width="105"/>
                                                <DataGridTextColumn Header="历史分位数" Binding="{Binding HistoricalSpreadPercentile, StringFormat='{}{0:F1}%'}" Width="95"/>
                                                <DataGridTextColumn Header="低位波动压缩" Binding="{Binding VolatilityCompressionRatio, StringFormat='{}{0:F2}'}" Width="95"/>
                                                <DataGridTextColumn Header="短期急涨幅" Binding="{Binding ShortTermReturnRunUp, StringFormat='{}{0:+0.00;-0.00;0.00}%'}" Width="95"/>
                                                <DataGridTextColumn Header="拥挤指数(0-100)" Binding="{Binding CrowdingScore, StringFormat='{}{0:F1}'}" Width="110"/>
                                                <DataGridTextColumn Header="拥挤风险研判" Binding="{Binding RiskStatus}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Border Background="#181825" CornerRadius="4" Padding="8,4">
                                            <TextBlock Text="{Binding FactorCrowding.InstitutionalRiskWarning, FallbackValue='因子拥挤度与估值差离散度监测就绪。'}"
                                                       FontSize="11" Foreground="#BAC2DE" TextWrapping="Wrap"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 13: 🤖 AI 模拟操盘 -->
                    <TabItem Header="🤖 AI 模拟操盘">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                            <StackPanel Margin="0,0,4,10">
                                <Border Background="#1E1E2E" BorderBrush="#F5B041" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#F5B041" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                    <TextBlock Text="AI 模拟盘" FontSize="11" FontWeight="Black" Foreground="#11111B"/>
                                                </Border>
                                                <TextBlock Text="标的实时模拟操盘与 10 万元现金推演" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="🚀 进入 AI 模拟操盘完整工作台" Command="{Binding OpenAiSimulationCommand}"
                                                    Background="#F5B041" Foreground="#11111B" FontWeight="Bold" Padding="10,4" Cursor="Hand"/>
                                        </DockPanel>

                                        <TextBlock Text="当前基金可在 10 万元模拟现金池中直接买入加仓、按份额赎回卖出，并由系统根据 4433、量化得分与科学投决信号持续盯盘诊断。" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,14"/>

                                        <UniformGrid Columns="3" Margin="0,0,0,14">
                                            <Border Background="#181825" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="当前基金代码/名称" Foreground="#585B70" FontSize="10.5"/>
                                                    <TextBlock Text="{Binding CurrentFund.DisplayText, FallbackValue='000001 华夏成长'}" FontSize="13" FontWeight="Bold" Foreground="#89B4FA" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#181825" CornerRadius="6" Padding="10,8" Margin="0,0,6,0">
                                                <StackPanel>
                                                    <TextBlock Text="AI 科学投决最新研判" Foreground="#585B70" FontSize="10.5"/>
                                                    <TextBlock Text="{Binding ScientificAdvice.ActionSignalText, FallbackValue='🛡️ 继续持有 (锁定底仓)'}" FontSize="13" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="#181825" CornerRadius="6" Padding="10,8">
                                                <StackPanel>
                                                    <TextBlock Text="模拟初始资金储备" Foreground="#585B70" FontSize="10.5"/>
                                                    <TextBlock Text="100,000 元 (现金流)" FontSize="13" FontWeight="Bold" Foreground="#F5B041" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </UniformGrid>

                                        <Border Background="#252638" CornerRadius="6" Padding="12,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="💡 快捷模拟操作：" FontWeight="Bold" Foreground="#FFFFFF" FontSize="12"/>
                                                    <TextBlock Text="点击右侧按钮直接带入金额模拟买入当前基金，或切换至完整工作台体验 AI 一键 10 万建仓与基准收益曲线。" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="🎯 立即模拟买入此基" Command="{Binding SimulateBuyCurrentFundCommand}"
                                                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="12" Padding="12,6" Margin="0,0,8,0" Cursor="Hand"/>
                                                    <Button Content="📈 查看模拟收益走势" Command="{Binding OpenAiSimulationCommand}"
                                                            Background="#313244" Foreground="#CDD6F4" FontWeight="SemiBold" FontSize="12" Padding="12,6" Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- 右侧：定投策略仿真回测面板 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="{Binding BacktestResult.StrategyName, FallbackValue='策略仿真回测'}"
                                   FontSize="14" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Left"
                                   ToolTip="{Binding BacktestResult.StrategyDescription}"/>
                        <TextBlock Text="{Binding BacktestResult.AverageCostPrice, StringFormat='持仓均价: {0:F4}元', FallbackValue=''}"
                                   FontSize="11" Foreground="#A6ADC8" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 参数控制栏 -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="策略: " VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        <ComboBox SelectedIndex="{Binding SelectedStrategyIndex}" Width="135" Margin="2,0,8,0"
                                  SelectionChanged="StrategyCombo_SelectionChanged">
                            <ComboBoxItem Content="普通定投"/>
                            <ComboBoxItem Content="MA60择时"/>
                            <ComboBoxItem Content="目标止盈(+15%)"/>
                            <ComboBoxItem Content="网格交易(3%)"/>
                            <ComboBoxItem Content="估值分位定投"/>
                            <ComboBoxItem Content="股债动态平衡"/>
                        </ComboBox>

                        <TextBlock Text="每期: " VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding DcaAmount, UpdateSourceTrigger=PropertyChanged}" Width="50"
                                 Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="3" Margin="2,0,6,0"/>
                        <TextBlock Text="元" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="0,0,8,0"/>

                        <TextBlock Text="频率: " VerticalAlignment="Center" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                        <ComboBox SelectedIndex="{Binding SelectedFrequencyIndex}" Width="85" Margin="2,0,8,0">
                            <ComboBoxItem Content="每周四"/>
                            <ComboBoxItem Content="每周一"/>
                            <ComboBoxItem Content="每月初"/>
                        </ComboBox>

                        <!-- 动态专属策略参数控件区 -->
                        <!-- MA择时专属参数 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="1">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="均线: " VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding MaPeriod, UpdateSourceTrigger=PropertyChanged}" Width="36" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="3,2" TextAlignment="Center"/>
                            <TextBlock Text="日" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="2,0,0,0"/>
                        </StackPanel>

                        <!-- 目标止盈专属参数 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="2">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="止盈: " VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding TargetProfitThreshold, UpdateSourceTrigger=PropertyChanged}" Width="36" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="3,2" TextAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="2,0,0,0"/>
                        </StackPanel>

                        <!-- 网格交易专属参数 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="3">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="间距: " VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding GridSpacingPercent, UpdateSourceTrigger=PropertyChanged}" Width="36" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="3,2" TextAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="2,0,0,0"/>
                        </StackPanel>

                        <!-- 估值分位专属参数 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="4">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="窗口: " VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding ValuationWindow, UpdateSourceTrigger=PropertyChanged}" Width="40" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="3,2" TextAlignment="Center"/>
                            <TextBlock Text="日" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="2,0,0,0"/>
                        </StackPanel>

                        <!-- 股债平衡专属参数 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="5">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="偏离: " VerticalAlignment="Center" Foreground="{StaticResource MutedText}"/>
                            <TextBox Text="{Binding RebalanceThresholdPercent, UpdateSourceTrigger=PropertyChanged}" Width="36" Background="#181825" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="3,2" TextAlignment="Center"/>
                            <TextBlock Text="%" VerticalAlignment="Center" Foreground="{StaticResource MutedText}" Margin="2,0,0,0"/>
                        </StackPanel>

                        <Button Content="回测" Command="{Binding RunBacktestCommand}"
                                Style="{StaticResource TimeBtnStyle}" Background="#89B4FA" Foreground="#11111B" Padding="10,3"/>
                    </StackPanel>

                    <!-- 回测统计表格卡片 -->
                    <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="定投总期数" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.TotalPeriods, StringFormat='{}{0} 期', FallbackValue='0'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="累计投入本金" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.TotalInvested, StringFormat='{}{0:N0} 元', FallbackValue='0'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#CDD6F4"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,0,0">
                                <TextBlock Text="期末持仓资产" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.FinalAssetValue, StringFormat='{}{0:N0} 元', FallbackValue='0'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#89B4FA"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,8,0,0">
                                <TextBlock Text="定投净利润" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.TotalProfit, StringFormat='{}{0:+0.00;-0.00;0.00} 元', FallbackValue='0'}"
                                           FontSize="16" FontWeight="Bold" Foreground="#F38BA8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,0,0">
                                <TextBlock Text="定投总收益率" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.TotalReturnRate, StringFormat='{}{0:+0.00;-0.00;0.00}%', FallbackValue='0.00%'}"
                                           FontSize="18" FontWeight="Bold" Foreground="#F38BA8"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,8,0,0">
                                <TextBlock Text="年化内部报酬率 (IRR)" Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.AnnualizedIrr, StringFormat='{}{0:+0.00;-0.00;0.00}%', FallbackValue='0.00%'}"
                                           FontSize="18" FontWeight="Bold" Foreground="#FAB387"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                <TextBlock Text="{Binding BacktestResult.BuyAndHoldReturnRate, StringFormat='对照组（期初一次性全仓买入收益率）: {0:+0.00;-0.00;0.00}%', FallbackValue='--'}"
                                           Foreground="{StaticResource MutedText}" FontSize="11"/>
                                <TextBlock Text="{Binding BacktestResult.RealizedProfit, StringFormat='🎯 止盈锁定落袋: {0:N2} 元', FallbackValue=''}"
                                           Foreground="#A6E3A1" FontSize="11" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="2">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding BacktestResult.GridArbitrageProfit, StringFormat='⚡ 网格累计套利毛利: {0:N2} 元', FallbackValue=''}"
                                           Foreground="#F5B041" FontSize="11" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="3">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="📊 估值自适应倍投加减仓模型已生效 (滚动250日历史分位数)"
                                           Foreground="#94E2D5" FontSize="11" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="4">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding BacktestResult.RebalanceCount, StringFormat='⚖️ 股债平衡触发再平衡: {0} 次 | 权益/固收持仓平抑极端回撤', FallbackValue=''}"
                                           Foreground="#CBA6F7" FontSize="11" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStrategyIndex}" Value="5">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</TabItem>

