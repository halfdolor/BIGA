                        <!-- 2. 中部四栏式量化明细 (A-C清算排期、Michaud重抽样前沿、反向破产拓扑、Cornish-Fisher修正) -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.3*"/>
