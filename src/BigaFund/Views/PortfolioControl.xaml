                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 1. 顶部 Phase 27 核心 KPI 卡片 -->
                        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="12,8" Margin="0,0,0,8" BorderBrush="#313244" BorderThickness="1">
