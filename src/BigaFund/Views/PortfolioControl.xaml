                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左列: 前十大穿透重仓股票 -->
                            <DataGrid x:Name="GridLookThroughHoldings" Grid.Column="0" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="180"
                                      Background="Transparent" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0"
                                      RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                      HeadersVisibility="Column" FontSize="11.5">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#A6E3A1"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
