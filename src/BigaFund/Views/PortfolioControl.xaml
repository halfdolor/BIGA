                                      RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                      HeadersVisibility="Column" FontSize="11.5">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#89B4FA"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="6,4"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="申万行业" Binding="{Binding IndustryName}" Width="100"/>
                                    <DataGridTextColumn Header="穿透暴露" Binding="{Binding PortfolioWeight, StringFormat='{}{0:F2}%'}" Width="85"/>
