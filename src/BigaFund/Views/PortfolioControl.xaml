<UserControl x:Class="BigaFund.Views.PortfolioControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="#11111B" Foreground="#FFFFFF"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. 组合配置与权重设定区 -->
            <RowDefinition Height="*"/>    <!-- 1. ScottPlot 组合净值走势图 -->
            <RowDefinition Height="Auto"/> <!-- 2. 组合核心量化指标看板 -->
        </Grid.RowDefinitions>

        <!-- 0. 组合配置与权重设定区 -->
        <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶行：操作栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩 资产配置组合:" FontWeight="Bold" FontSize="14" Foreground="#89B4FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtAddFundCode" Text="000001" Width="80" Background="#181825" Foreground="#FFFFFF"
                                 BorderBrush="#45475A" Padding="6,3" FontWeight="Bold" VerticalContentAlignment="Center"/>
                        <Button Content="➕ 添加基金" Width="85" Margin="8,0,14,0"
                                Background="#313244" Foreground="#FFFFFF" BorderBrush="#45475A" FontWeight="SemiBold" Padding="0,4"
                                Cursor="Hand" Click="BtnAddFund_Click"/>
                    </StackPanel>

                    <!-- 经典模板快速载入 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="经典范式:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="股债二八平衡" Margin="0,0,4,0" Padding="6,3" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" Click="BtnQuickTemplate_Click" Tag="BALANCED"/>
                        <Button Content="全天候红利大宗" Margin="0,0,4,0" Padding="6,3" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" Click="BtnQuickTemplate_Click" Tag="ALL_WEATHER"/>
                        <Button Content="科技医药双轮" Margin="0,0,4,0" Padding="6,3" Background="#181825" Foreground="#CDD6F4" BorderBrush="#313244" Click="BtnQuickTemplate_Click" Tag="GROWTH"/>
                    </StackPanel>

                    <!-- 时间区间选择 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="回测跨度:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="CmbTimeRange" Width="80" SelectedIndex="3" Foreground="#FFFFFF" SelectionChanged="CmbTimeRange_SelectionChanged">
                            <ComboBoxItem Content="近半年" Tag="6M"/>
                            <ComboBoxItem Content="近1年" Tag="1Y"/>
                            <ComboBoxItem Content="近3年" Tag="3Y"/>
                            <ComboBoxItem Content="全历程" Tag="ALL"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 权重校验提示 -->
                    <TextBlock x:Name="TxtWeightStatus" Grid.Column="3" Text="当前总权重: 100% (有效)" 
                               Foreground="#A6E3A1" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,16,0"/>

                    <Button Grid.Column="4" Content="⚖️ 等权平分" Width="90" Margin="0,0,8,0"
                            Background="#313244" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="0,4"
                            Click="BtnEqualWeight_Click"/>

                    <Button Grid.Column="5" Content="📄 基础研报" Width="85" Margin="0,0,6,0"
                            Background="#313244" Foreground="#89B4FA" BorderBrush="#89B4FA" BorderThickness="1" Padding="0,4"
                            FontWeight="SemiBold" Cursor="Hand" Click="BtnExportHtml_Click"
                            ToolTip="导出为专业机构级 HTML 资产配置研报 (含权重/MPT对比/相关性/压力测试，支持直接打印或转 PDF)"/>

                    <Button Grid.Column="6" Content="📑 高管路演 Deck" Width="110" Margin="0,0,8,0"
                            Background="#313244" Foreground="#F5B041" BorderBrush="#F5B041" BorderThickness="1" Padding="0,4"
                            FontWeight="SemiBold" Cursor="Hand" Click="BtnExportPitchDeck_Click"
                            ToolTip="导出为面向投资决策委员会/高管层的 360° 全景募资与策略推介路演研报 (Executive Pitch Deck)"/>

                    <Button Grid.Column="7" Content="🚀 开始回测" Width="95"
                            Background="#F5B041" Foreground="#11111B" BorderThickness="0" FontWeight="Bold" Padding="0,5"
                            Cursor="Hand" Click="BtnRunBacktest_Click"/>
                </Grid>

                <!-- 中间行：MPT 现代投资组合理论求解优化方案工具条 -->
                <Border Grid.Row="1" Background="#252636" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📐 MPT 组合优化求解: " Foreground="#BAC2DE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="BtnMaxSharpe" Content="🎯 最大夏普" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#F5B041" BorderBrush="#F5B041" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnMaxSharpe_Click" ToolTip="寻找切点组合 (Tangency Portfolio)，在同等风险下获取最大超额收益"/>
                            <Button x:Name="BtnMinVariance" Content="🛡️ 最小方差" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#89B4FA" BorderBrush="#89B4FA" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnMinVariance_Click" ToolTip="基于马科维茨协方差矩阵，寻找全市场组合波动率最低的防御盾牌配置"/>
                            <Button x:Name="BtnRiskParity" Content="⚖️ 风险平价" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#A6E3A1" BorderBrush="#A6E3A1" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnRiskParity_Click" ToolTip="桥水全天候策略 (Bridgewater All-Weather)，使每只成分资产对组合总方差的边际风险贡献完全相等"/>
                            <Button x:Name="BtnMomentumRiskBudget" Content="⚡ 动量风险预算" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#CBA6F7" BorderBrush="#CBA6F7" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnMomentumRiskBudget_Click" ToolTip="结合截面动量因子与逆波动率自适应调节各资产风险预算，兼顾趋势进攻与抗跌平抑"/>
                            <Button x:Name="BtnBlackLitterman" Content="🧠 Black-Litterman" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#FAB387" BorderBrush="#FAB387" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnBlackLitterman_Click" ToolTip="贝叶斯均衡超额收益优化模型 (Black-Litterman)，融合全市场基准均衡先验与自适应动量主观观点"/>
                            <Button x:Name="BtnHrp" Content="🧬 HRP 机器学习" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#94E2D5" BorderBrush="#94E2D5" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnHrp_Click" ToolTip="Marcos López de Prado 层次风险平价 (Hierarchical Risk Parity)，无需求逆协方差矩阵，通过图论树聚类与递归双分获取卓越样本外稳健性"/>
                            <Button x:Name="BtnMeanCVaR" Content="🛡️ 均值-CVaR" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#F38BA8" BorderBrush="#F38BA8" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnMeanCVaR_Click" ToolTip="Rockafellar-Uryasev 极值尾部损失优化，直接极小化 95% CVaR，应对黑天鹅肥尾暴跌"/>
                            <Button x:Name="BtnMdp" Content="🌐 最大分散 (MDP)" Margin="0,0,6,0" Background="#1E1E2E" Foreground="#89DCEB" BorderBrush="#89DCEB" BorderThickness="1" Padding="6,3" FontWeight="Bold" Cursor="Hand" Click="BtnMdp_Click" ToolTip="Choueifaty 最大分散化投资组合，最大化分散化比率 DR，纯正利用资产间低相关性追求最大分散降波红利"/>
                        </StackPanel>
                        <TextBlock x:Name="TxtMptSummary" Grid.Column="1" Text="回测后将自动求解八套机构级最优权重方案供一键套用" Foreground="#A6ADC8" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" Margin="10,0,0,0"/>
                    </Grid>
                </Border>

                <!-- 底行：成分基金权重微调列表 -->
                <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="6" BorderBrush="#313244" BorderThickness="1">
                    <DataGrid x:Name="GridComponents" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                              RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                              HeadersVisibility="Column" FontSize="12">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="基金代码" Binding="{Binding Code}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="基金名称" Binding="{Binding Name}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding Type}" IsReadOnly="True" Width="100"/>
                            <DataGridTemplateColumn Header="目标配置权重 (%)" Width="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="0" Maximum="100" Value="{Binding WeightPercent, UpdateSourceTrigger=PropertyChanged}"
                                                    TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                                    ValueChanged="WeightSlider_ValueChanged"/>
                                            <TextBox Grid.Column="1" Text="{Binding WeightPercent, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="#313244" Foreground="#FFFFFF" BorderBrush="#45475A" 
                                                     Padding="2" TextAlignment="Right" Margin="6,0,0,0"
                                                     TextChanged="WeightText_TextChanged"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="操作" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑️ 移除" Tag="{Binding Code}" 
                                                Background="Transparent" Foreground="#F38BA8" BorderThickness="0"
                                                Click="BtnRemoveFund_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <!-- 1. ScottPlot 核心量化图表交互区 (支持：组合历史回测 / 马科维茨有效前沿 / 蒙特卡洛扇形概率锥) -->
        <Border Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 图表模式切换工具栏 -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <RadioButton x:Name="RbPlotNav" Content="📈 组合净值走势" IsChecked="True"
                                     Foreground="#BAC2DE" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0"
                                     Checked="RbPlotMode_Checked"/>
                        <RadioButton x:Name="RbPlotFrontier" Content="📐 马科维茨有效前沿 (MPT)"
                                     Foreground="#BAC2DE" FontSize="12" FontWeight="SemiBold" Margin="0,0,14,0"
                                     Checked="RbPlotMode_Checked"/>
                        <RadioButton x:Name="RbPlotMonteCarlo" Content="🎲 蒙特卡洛扇形概率锥 (GBM)"
                                     Foreground="#BAC2DE" FontSize="12" FontWeight="SemiBold"
                                     Checked="RbPlotMode_Checked"/>
                    </StackPanel>

                    <Border Background="#252636" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtCrosshairInfo" Text="双击恢复视角 | 滚轮局部缩放 | 鼠标拖拽平移" Foreground="#A6ADC8" FontSize="11"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <sp:WpfPlot x:Name="PortfolioPlot"/>
                    <ProgressBar x:Name="PlotLoading" IsIndeterminate="True" Width="180" Height="6" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. 组合量化诊断与投研看板 (核心风控 / 相关性矩阵 / 极端黑天鹅压测) -->
        <Border Grid.Row="2" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#181825"/>
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#313244"/>
                                            <Setter Property="Foreground" Value="#F5B041"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: 核心量化指标看板 (8大机构风控指标 + 高级非正态下行体系 + Top 5 历史回撤周期) -->
                <TabItem Header="📊 核心风控指标">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="280">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <UniformGrid Grid.Row="0" Columns="4">
                                <!-- 累计收益率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="组合累计收益率" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtTotalReturn" Text="--%" FontSize="20" FontWeight="Bold" Foreground="#F38BA8" Margin="0,4,0,0"/>
                                        <TextBlock x:Name="TxtCsi300Compare" Text="跑赢沪深300: --" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 年化复合收益率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="组合年化复合增长率" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtAnnualizedReturn" Text="--%" FontSize="20" FontWeight="Bold" Foreground="#F38BA8" Margin="0,4,0,0"/>
                                        <TextBlock Text="按实际交集交易日复利折算" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 历史最大回撤 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="组合历史最大回撤" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtMaxDrawdown" Text="--%" FontSize="20" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                        <TextBlock Text="资产配置降低组合尾部风险" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 夏普比率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="组合夏普比率 (Sharpe)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtSharpe" Text="--" FontSize="20" FontWeight="Bold" Foreground="#F5B041" Margin="0,4,0,0"/>
                                        <TextBlock Text="无风险利率 Rf=2.0%" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Grid.Row="1" Columns="4" Margin="0,4,0,0">
                                <!-- 卡玛比率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="组合卡玛比率 (Calmar)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtCalmar" Text="--" FontSize="20" FontWeight="Bold" Foreground="#89B4FA" Margin="0,4,0,0"/>
                                        <TextBlock Text="年化收益 / 最大回撤" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 在险价值 VaR / CVaR -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="95% 在险价值 (VaR / CVaR)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtVaR" Text="-- / --" FontSize="17" FontWeight="Bold" Foreground="#F38BA8" Margin="0,4,0,0"/>
                                        <TextBlock Text="单日极端尾部风险测算" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 特雷诺与跟踪误差 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="特雷诺比率 / 跟踪误差 (TE)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtTreynorAndTe" Text="-- / --" FontSize="17" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,4,0,0"/>
                                        <TextBlock Text="系统性风险单位补偿与偏离度" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 机构捕获比率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="机构捕获比率 (UCR / DCR)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtCaptureRatio" Text="-- (U:-- / D:--)" FontSize="15" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                        <TextBlock Text="上行跟涨 / 下行防御综合度量" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Grid.Row="2" Columns="4" Margin="0,4,0,0">
                                <!-- 奥米加比率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="奥米加比率 (Omega Ratio)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtOmega" Text="--" FontSize="18" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                        <TextBlock Text="高于/低于Rf门槛概率质量比" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 溃疡指数 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="溃疡指数 (Ulcer Index)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtUlcer" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#FAB387" Margin="0,4,0,0"/>
                                        <TextBlock Text="回撤深度与水下滞留均方根" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 马丁比率 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="马丁比率 (Martin Ratio)" Foreground="#A6ADC8" FontSize="11"/>
                                        <TextBlock x:Name="TxtMartin" Text="--" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" Margin="0,4,0,0"/>
                                        <TextBlock Text="超额收益 / 溃疡指数 UI" Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <!-- 收益痛苦比与下行偏差 -->
                                <Border Background="#181825" CornerRadius="6" Padding="12,8" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="收益痛苦比 / 下行偏差 (σ_down)" Foreground="#A6ADC8" FontSize="11"/>
