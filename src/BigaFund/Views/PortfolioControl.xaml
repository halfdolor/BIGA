                                        <DataGridTextColumn Header="张量场 Alpha" Binding="{Binding TensorRingAlphaFieldBps, StringFormat={}+{0:F1} bps}" Width="95" Foreground="#A6E3A1" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="张量态评级" Binding="{Binding TensorRegimeBadge}" Width="120"/>
                                        <DataGridTextColumn Header="张量流形指令" Binding="{Binding TensorAdvice}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <!-- Group 4: 维纳-泊松空间马利亚温微分跳跃扩散随机波动率对冲 DataGrid -->
                            <GroupBox Grid.Row="4" Header="4. Citadel &amp; Jump Trading: 维纳-泊松空间马利亚温微分 (Malliavin Calculus) 跳跃扩散随机波动率对冲引擎" Style="{StaticResource SectionGroupBoxStyle}" Margin="0,0,0,12">
                                <DataGrid x:Name="DgMalliavinJumpDiffusionHedging" Style="{StaticResource ModernDataGridStyle}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="220">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="标的代码" Binding="{Binding AssetCode}" Width="85" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="标的名称" Binding="{Binding AssetName}" Width="110"/>
                                        <DataGridTextColumn Header="基准权重" Binding="{Binding Weight, StringFormat={}{0:F1}%}" Width="75"/>
                                        <DataGridTextColumn Header="马利亚温 Delta" Binding="{Binding MalliavinDeltaRatio, StringFormat={}{0:F2}}" Width="95" Foreground="#89B4FA" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Gamma 曲率" Binding="{Binding MalliavinGammaSensitivity, StringFormat={}{0:F3}}" Width="90" Foreground="#F9E2AF"/>
                                        <DataGridTextColumn Header="跳跃强度(次/年)" Binding="{Binding JumpDiffusionHazardIntensity, StringFormat={}{0:F1}}" Width="105" Foreground="#F38BA8"/>
                                        <DataGridTextColumn Header="免疫目标权重" Binding="{Binding MalliavinImmunizedTargetWeight, StringFormat={}{0:F1}%}" Width="95" Foreground="#89B4FA" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="变分对冲 Alpha" Binding="{Binding MalliavinHedgingAlphaBps, StringFormat={}+{0:F1} bps}" Width="100" Foreground="#A6E3A1" FontWeight="Bold"/>
                                        <DataGridTextColumn Header="对冲评级" Binding="{Binding MalliavinRegimeBadge}" Width="120"/>
                                        <DataGridTextColumn Header="变分对冲指令" Binding="{Binding MalliavinAdvice}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <!-- 底栏: Phase 62 顶级量化执行裁决书与尽调研报导出 -->
                            <Border Grid.Row="5" Background="#181825" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="🏛️ Phase 62 全球顶级多经理对冲基金与主权配置机构专家委员会终极执行裁决书" FontSize="12" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtPhase62ExecutiveVerdict" Text="正在执行 Phase 62 前沿量化投研模型求解..." TextWrapping="Wrap" FontSize="11" Foreground="#CDD6F4" LineHeight="16"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="BtnExportPhase62Report"
                                            Content="📑 导出 Phase 62 机构终极研报"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Padding="12,6" FontSize="11" FontWeight="Bold"
                                            Click="BtnExportInstitutionalDueDiligence_Click"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
