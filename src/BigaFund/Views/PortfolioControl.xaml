                        </Border>
                    </Grid>
                </TabItem>

                <!-- Phase 18: FOF 组合持仓重叠度消冗矩阵与伪分散告警 -->
                <TabItem Header="🔍 持仓重叠消冗矩阵">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶层汇总状态栏 -->
                        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtOverlapHeader" Text="平均两两重叠率: --% | 最大重叠对: -- | 冗余预警对数: 0 对 | 分散评级: 优良"
                                           Foreground="#89B4FA" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text=" | " Foreground="#45475A" FontSize="12" Margin="6,0"/>
                                <TextBlock x:Name="TxtOverlapScore" Text="冗余度指数: -- / 100"
                                           Foreground="#F5B041" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- 两两基金持仓重叠度消冗明细数据表 -->
                        <DataGrid x:Name="GridHoldingsOverlap" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="180"
                                  Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                  RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                  HeadersVisibility="Column" FontSize="11.5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#313244"/>
                                    <Setter Property="Foreground" Value="#F5B041"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="基金对" Binding="{Binding PairTitle}" Width="190"/>
                                <DataGridTextColumn Header="加权重叠率" Binding="{Binding WeightedOverlapPercent, StringFormat='{}{0:F1}%'}" Width="85"/>
                                <DataGridTextColumn Header="Jaccard 集合重叠" Binding="{Binding JaccardSimilarity, StringFormat='{}{0:F1}%'}" Width="110"/>
                                <DataGridTextColumn Header="余弦相似度" Binding="{Binding CosineSimilarity, StringFormat='{}{0:F3}'}" Width="85"/>
                                <DataGridTextColumn Header="共同重仓数" Binding="{Binding CommonStockCount, StringFormat='{}{0} 只'}" Width="80"/>
                                <DataGridTextColumn Header="同质化预警" Binding="{Binding OverlapSeverity}" Width="95"/>
                                <DataGridTextColumn Header="共同前十大重仓明细 (穿透标的)" Binding="{Binding TopOverlappingStocks}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- 底部专家消冗建议提示卡 -->
                        <Border Grid.Row="2" Background="#181825" CornerRadius="4" Padding="8,5" Margin="0,6,0,0">
                            <TextBlock x:Name="TxtOverlapAdvice" Text="等待组合持仓计算以诊断重叠消冗建议..." FontSize="11" Foreground="#BAC2DE" TextWrapping="Wrap"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 7: 几何布朗运动 (GBM) 前瞻性蒙特卡洛资产概率推演 -->
                <TabItem Header="🎲 蒙特卡洛推演">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 顶行: 概率分位数核心 KPI 卡片 -->
                        <UniformGrid Grid.Row="0" Columns="5" Margin="0,0,0,8">
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="95% 乐观上限 (牛市)" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtMcUpper95" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#F38BA8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtMcNav95" Text="推演净值: --" Foreground="#BAC2DE" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="50% 中位稳态 (基准)" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtMcMedian" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtMcNavMedian" Text="推演净值: --" Foreground="#BAC2DE" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="5% 悲观底线 (熊市防线)" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtMcLower5" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtMcNav5" Text="推演净值: --" Foreground="#BAC2DE" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="本金亏损概率 (破本)" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtMcLossProb" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#F5B041" Margin="0,2,0,0"/>
                                    <TextBlock Text="未来 1 年亏损概率" Foreground="#A6ADC8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="模拟预期最大回撤" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtMcExpectedDrawdown" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#FAB387" Margin="0,2,0,0"/>
                                    <TextBlock Text="随机漫步预期回撤深度" Foreground="#A6ADC8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 中行: 诊断结论与模型参数 -->
                        <Border Grid.Row="1" Background="#181825" CornerRadius="6" Padding="10,6" Margin="4,0,4,4">
                            <TextBlock x:Name="TxtMcSummary" Text="蒙特卡洛推演报告生成中..." FontSize="11.5" Foreground="#CDD6F4" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- Tab 8: 宏观情景与因子冲击前瞻性压力测试 (Bloomberg PORT 规范) -->
                <TabItem Header="⚡ 宏观情景冲击">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 预设情景快速测试按钮栏 -->
                        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="8,6" Margin="4,0,4,6">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="预设宏观情景:" Foreground="#BAC2DE" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Button x:Name="BtnScenarioS1" Content="🐻 A股系统性深度踩踏" Background="#313244" Foreground="#F38BA8" Padding="8,3" Margin="2" Click="BtnScenarioPreset_Click" Tag="S1"/>
                                <Button x:Name="BtnScenarioS2" Content="📉 权益温和回调" Background="#313244" Foreground="#FAB387" Padding="8,3" Margin="2" Click="BtnScenarioPreset_Click" Tag="S2"/>
                                <Button x:Name="BtnScenarioS3" Content="🐂 估值修复牛市" Background="#313244" Foreground="#A6E3A1" Padding="8,3" Margin="2" Click="BtnScenarioPreset_Click" Tag="S3"/>
                                <Button x:Name="BtnScenarioS4" Content="📈 滞胀加息紧缩" Background="#313244" Foreground="#CBA6F7" Padding="8,3" Margin="2" Click="BtnScenarioPreset_Click" Tag="S4"/>
                                <Button x:Name="BtnScenarioS5" Content="🛡️ 稳增长政策宽松" Background="#313244" Foreground="#89B4FA" Padding="8,3" Margin="2" Click="BtnScenarioPreset_Click" Tag="S5"/>
                                <Button x:Name="BtnScenarioS6" Content="🌪️ 微盘流动性踩踏" Background="#313244" Foreground="#EBA0AC" Padding="8,3" Margin="2" Click="BtnScenarioPreset_Click" Tag="S6"/>
                            </WrapPanel>
                        </Border>

                        <!-- 自定义宏观滑块控制器 -->
                        <Border Grid.Row="1" Background="#181825" CornerRadius="6" Padding="10,6" Margin="4,0,4,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="65"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="权益市场冲击 (ΔS):" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider Grid.Column="1" x:Name="SliderEquityShock" Minimum="-50" Maximum="50" Value="-15" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderShock_ValueChanged"/>
                                <TextBlock Grid.Column="2" x:Name="TxtEquityShockVal" Text="-15%" Foreground="#F38BA8" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>

                                <TextBlock Grid.Column="4" Text="无风险利率冲击 (Δy):" Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider Grid.Column="5" x:Name="SliderRateShock" Minimum="-200" Maximum="200" Value="25" TickFrequency="25" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SliderShock_ValueChanged"/>
                                <TextBlock Grid.Column="6" x:Name="TxtRateShockVal" Text="+25 bps" Foreground="#F5B041" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- KPI 结果展示卡片 -->
                        <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,6">
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="预估组合净值冲击" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtShockNavChange" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#F38BA8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtShockScenarioName" Text="情景: --" Foreground="#BAC2DE" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="预估金额损益 (100万本金)" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtShockPnL" Text="-- 元" FontSize="18" FontWeight="Bold" Foreground="#F5B041" Margin="0,2,0,0"/>
                                    <TextBlock Text="组合整体拟合暴露损益" Foreground="#A6ADC8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="受压单日在险价值 (VaR95)" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtShockStressedVaR" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#EBA0AC" Margin="0,2,0,0"/>
                                    <TextBlock Text="市场剧烈受创后尾部风险" Foreground="#A6ADC8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="组合抗冲击韧性评级" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtShockRating" Text="--" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtShockDescription" Text="--" Foreground="#BAC2DE" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 各基金在受压情景下的受损与贡献明细表 -->
                        <DataGrid Grid.Row="3" x:Name="GridShockFundImpacts" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MaxHeight="180"
                                  Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                  RowBackground="#181825" AlternatingRowBackground="#1E1E2E"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                  HeadersVisibility="Column" FontSize="11.5">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#313244"/>
                                    <Setter Property="Foreground" Value="#89B4FA"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="基金代码" Binding="{Binding FundCode}" Width="75"/>
                                <DataGridTextColumn Header="基金名称" Binding="{Binding FundName}" Width="160"/>
                                <DataGridTextColumn Header="配置权重" Binding="{Binding WeightPercent, StringFormat='{}{0:F1}%'}" Width="80"/>
                                <DataGridTextColumn Header="拟合 Beta" Binding="{Binding Beta, StringFormat='{}{0:F2}'}" Width="80"/>
                                <DataGridTextColumn Header="预估净值变动" Binding="{Binding EstimatedNavChangePercent, StringFormat='{}{0:+0.00;-0.00;0.00}%'}" Width="100"/>
                                <DataGridTextColumn Header="对组合损益贡献度" Binding="{Binding ContributionPercent, StringFormat='{}{0:F1}%'}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 9: 🔄 动态再平衡时序仿真与换手磨损 -->
                <TabItem Header="🔄 动态再平衡仿真">
                    <Grid Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 控制工具栏: 策略选择 + 初始本金 + 仿真执行 -->
                        <Border Grid.Row="0" Background="#252636" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="再平衡策略模式: " Foreground="#BAC2DE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox x:Name="CmbRebalanceStrategy" SelectedIndex="0" Foreground="#FFFFFF" Width="170" Margin="0,0,16,0">
                                        <ComboBoxItem Content="月度定期再平衡 (首日)"/>
                                        <ComboBoxItem Content="季度定期再平衡 (初)"/>
                                        <ComboBoxItem Content="权重偏离阈值 (±5%)"/>
                                        <ComboBoxItem Content="买入持有基准 (零调仓)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="初始仿真本金: " Foreground="#BAC2DE" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBox x:Name="TxtRebalanceCapital" Text="1000000" Width="85" Background="#181825" Foreground="#F5B041" BorderBrush="#45475A" Padding="4,2" FontSize="11.5" FontWeight="Bold"/>
                                    <TextBlock Text=" 元" Foreground="#A6ADC8" FontSize="11.5" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" x:Name="BtnRunRebalance" Content="⚡ 执行动态再平衡测算" Width="150"
                                        Background="#313244" Foreground="#89B4FA" BorderBrush="#89B4FA" BorderThickness="1" Padding="0,4"
                                        FontWeight="SemiBold" Cursor="Hand" Click="BtnRunRebalance_Click"/>
                                <TextBlock Grid.Column="3" Text="💡 自动扣减0.15%单边交易冲击与申赎费，真实评估再平衡阿尔法与换手损耗" 
                                           Foreground="#A6ADC8" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- 指标卡片 (4 列) -->
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,6">
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="策略净终值收益率" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtRebalanceTotalReturn" Text="--%" FontSize="18" FontWeight="Bold" Foreground="#F38BA8" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtRebalanceAlpha" Text="vs买入持有: --%" Foreground="#A6E3A1" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="年化复合回报 / 波动率" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock Foreground="#FAB387" FontSize="18" FontWeight="Bold" Margin="0,2,0,0">
                                        <Run x:Name="TxtRebalanceCagr" Text="--%"/>
                                        <Run Text=" / "/>
                                        <Run x:Name="TxtRebalanceVol" Text="--%"/>
                                    </TextBlock>
                                    <TextBlock Text="年化复合 CAGR / 年化 Vol" Foreground="#A6ADC8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="最大回撤 / 夏普比率" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock Foreground="#89B4FA" FontSize="18" FontWeight="Bold" Margin="0,2,0,0">
                                        <Run x:Name="TxtRebalanceMaxDd" Text="--%"/>
                                        <Run Text=" | S: "/>
                                        <Run x:Name="TxtRebalanceSharpe" Text="--"/>
                                    </TextBlock>
                                    <TextBlock Text="再平衡平抑资产极端膨胀风险" Foreground="#A6ADC8" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="4">
                                <StackPanel>
                                    <TextBlock Text="换手率与摩擦磨损" Foreground="#A6ADC8" FontSize="11"/>
                                    <TextBlock x:Name="TxtRebalanceTurnover" Text="--%" FontSize="17" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtRebalanceFeeLoss" Text="摩擦损耗: ¥0 (拖累 0.00%)" Foreground="#BAC2DE" FontSize="10.5" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 再平衡事件流明细表 -->
