                                    <TextBlock x:Name="TxtMichaudBestSharpe" Text="前沿最优夏普: --" FontSize="10" Foreground="#BAC2DE"/>
                                </StackPanel>

                                <!-- 反向压力测试马氏距离与厚尾放大 -->
                                <StackPanel Grid.Column="4" Margin="4,0">
                                    <TextBlock Text="反向破产临界马氏距离 (σ)" FontSize="10.5" Foreground="#A6ADC8"/>
