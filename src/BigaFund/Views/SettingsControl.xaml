<UserControl x:Class="BigaFund.Views.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#11111B" Foreground="#CDD6F4"
             FontFamily="Segoe UI, Microsoft YaHei UI">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,20" MaxWidth="1050" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 顶部说明卡片 -->
            <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="⚙️ 系统首选项与量化风控参数配置" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock Text="集中管理 DuckDB 本地持久化存储的量化风控基准、手续费模型、策略执行参数与存储引擎监控" FontSize="12" Foreground="#A6ADC8" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- 核心参数配置区域 (双列) -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="540"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左栏：量化与回测核心参数 -->
                <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="8" Padding="20,18" BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📐 量化模型与策略预设参数" Foreground="#F5B041" FontWeight="Bold" FontSize="14" Margin="0,0,0,18"/>

                        <!-- 无风险利率 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="无风险年化基准利率 (Rf)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="用于折算夏普比率、索提诺比率与 CAPM Alpha" FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="TxtRiskFreeRate" Text="2.0" Width="70" Background="#181825" Foreground="#F9E2AF" 
                                         BorderBrush="#45475A" Padding="8,4" TextAlignment="Right" FontWeight="Bold"/>
                                <TextBlock Text=" %" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#313244" Margin="0,0,0,14"/>

                        <!-- 申购费率折扣 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="默认申购手续费率 (折扣后)" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="主流互联网代销平台通常 1 折，一般为 0.10%~0.15%" FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="TxtFeeRate" Text="0.10" Width="70" Background="#181825" Foreground="#A6E3A1" 
                                         BorderBrush="#45475A" Padding="8,4" TextAlignment="Right" FontWeight="Bold"/>
                                <TextBlock Text=" %" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#313244" Margin="0,0,0,14"/>

                        <!-- 默认定投金额 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="默认每期定投基准金额" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="普通定投、均线择时与止盈策略的单期基准本金" FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="TxtDefaultDcaAmount" Text="1000" Width="70" Background="#181825" Foreground="#89B4FA" 
                                         BorderBrush="#45475A" Padding="8,4" TextAlignment="Right" FontWeight="Bold"/>
                                <TextBlock Text=" 元" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#313244" Margin="0,0,0,14"/>

                        <!-- 目标止盈阈值 -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="目标收益止盈定投阈值" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="当单轮定投收益率达到此阈值自动全部赎回落袋锁定" FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="TxtTargetProfitRate" Text="15.0" Width="70" Background="#181825" Foreground="#F38BA8" 
                                         BorderBrush="#45475A" Padding="8,4" TextAlignment="Right" FontWeight="Bold"/>
                                <TextBlock Text=" %" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <Separator Background="#313244" Margin="0,0,0,14"/>

                        <!-- 网格套利间距 -->
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="网格交易策略价格间距" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF"/>
                                <TextBlock Text="动态网格每格触碰加减仓百分比步长" FontSize="11" Foreground="#6C7086" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="TxtGridSpacing" Text="3.0" Width="70" Background="#181825" Foreground="#FAB387" 
                                         BorderBrush="#45475A" Padding="8,4" TextAlignment="Right" FontWeight="Bold"/>
                                <TextBlock Text=" %" VerticalAlignment="Center" Foreground="#FFFFFF" Margin="4,0,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- 保存与重置操作栏 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                            <TextBlock x:Name="TxtSaveFeedback" Text="" Foreground="#A6E3A1" VerticalAlignment="Center" Margin="0,0,14,0" FontWeight="SemiBold" FontSize="12"/>
                            <Button Content="恢复默认值" Width="95" Margin="0,0,10,0"
                                    Background="#313244" Foreground="#A6ADC8" BorderBrush="#45475A" Padding="0,7" FontWeight="SemiBold"
                                    Click="BtnReset_Click"/>
                            <Button Content="💾 保存首选项" Width="115"
                                    Background="#89B4FA" Foreground="#11111B" BorderThickness="0" FontWeight="Bold" Padding="0,7"
                                    Click="BtnSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 右栏：DuckDB 数据库存储引擎状态看板 -->
                <Border Grid.Column="2" Background="#1E1E2E" CornerRadius="8" Padding="20,18" BorderBrush="#313244" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🦆 DuckDB 列式数据库引擎存储状态" Foreground="#89B4FA" FontWeight="Bold" FontSize="14" Margin="0,0,0,18"/>

                        <Border Background="#181825" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="物理数据库路径" FontSize="11" Foreground="#6C7086"/>
                                <TextBox x:Name="TxtDbPath" Text="C:\Users\...\biga.duckdb" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#CDD6F4" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#181825" CornerRadius="8" Padding="12" BorderBrush="#313244" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="已缓存基金档案" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtCachedFundsCount" Text="0 只" FontSize="20" FontWeight="Bold" Foreground="#F5B041" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#181825" CornerRadius="8" Padding="12" BorderBrush="#313244" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="数据库文件大小" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtDbFileSize" Text="0.00 MB" FontSize="20" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#181825" CornerRadius="8" Padding="12" BorderBrush="#313244" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="净值历史序列记录" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtNavRecordsCount" Text="0 条" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#181825" CornerRadius="8" Padding="12" BorderBrush="#313244" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="沪深300基准记录" FontSize="11" Foreground="#A6ADC8"/>
                                    <TextBlock x:Name="TxtBenchmarkRecordsCount" Text="0 条" FontSize="18" FontWeight="Bold" Foreground="#CBA6F7" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="#181825" CornerRadius="8" Padding="14,12" BorderBrush="#45475A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="⚡ DuckDB 优势说明" FontWeight="SemiBold" FontSize="12" Foreground="#F5B041" Margin="0,0,0,4"/>
                                <TextBlock Text="• DuckDB 是专为分析型（OLAP）量化场景设计的嵌入式列式数据库，支持高并发向量化查询执行。" FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,2"/>
                                <TextBlock Text="• 所有基金走势、沪深300指数和自选基金均自动持久化保存在本地，即使断网或离线也能毫秒级秒开回测。" FontSize="11" Foreground="#A6ADC8" TextWrapping="Wrap" Margin="0,2"/>
                            </StackPanel>
                        </Border>

                        <Button Content="🔄 刷新数据库统计" Margin="0,14,0,0" HorizontalAlignment="Right"
                                Background="#313244" Foreground="#CDD6F4" BorderBrush="#45475A" Padding="12,6" FontWeight="SemiBold"
                                Click="BtnRefreshDbStats_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
