<UserControl x:Class="BigaFund.Views.FundCompareControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="#11111B" Foreground="#FFFFFF"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. 顶部选择与控制栏 -->
            <RowDefinition Height="260"/>  <!-- 1. 双基走势叠加图 -->
            <RowDefinition Height="*"/>    <!-- 2. 机构量化多维对决 Tab 面板 -->
        </Grid.RowDefinitions>

        <!-- 0. 顶部对比基金设定与时间选择 -->
        <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 基金 A 输入 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="#89B4FA" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="基金 A (主选)" FontSize="11" FontWeight="Bold" Foreground="#11111B"/>
                    </Border>
                    <TextBox x:Name="TxtFundA" Text="000001" Width="80" Background="#181825" Foreground="#89B4FA"
                             BorderBrush="#45475A" Padding="6,3" FontWeight="Bold" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="TxtNameA" Text="华夏成长混合" Foreground="#FFFFFF" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- VS 图标 -->
                <TextBlock Grid.Column="1" Text="⚡ VS ⚡" FontWeight="Black" FontSize="14" Foreground="#F5B041" VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- 基金 B 输入 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Border Background="#F38BA8" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="基金 B (对标)" FontSize="11" FontWeight="Bold" Foreground="#11111B"/>
                    </Border>
                    <TextBox x:Name="TxtFundB" Text="005827" Width="80" Background="#181825" Foreground="#F38BA8"
                             BorderBrush="#45475A" Padding="6,3" FontWeight="Bold" VerticalContentAlignment="Center"/>
                    <TextBlock x:Name="TxtNameB" Text="易方达蓝筹精选" Foreground="#FFFFFF" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 切换时间区间 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="统计区间: " Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="CmbTimeRange" SelectedIndex="3" Width="95" Foreground="#FFFFFF"
                              SelectionChanged="TimeRange_SelectionChanged">
                        <ComboBoxItem Content="近1个月" Tag="1M"/>
                        <ComboBoxItem Content="近3个月" Tag="3M"/>
                        <ComboBoxItem Content="近6个月" Tag="6M"/>
                        <ComboBoxItem Content="近1年" Tag="1Y"/>
                        <ComboBoxItem Content="近3年" Tag="3Y"/>
                        <ComboBoxItem Content="近5年" Tag="5Y"/>
                        <ComboBoxItem Content="全部交集" Tag="ALL"/>
                    </ComboBox>
                </StackPanel>

                <!-- PK 按钮 -->
                <Button Grid.Column="5" Content="🥊 立即对比 PK" Width="110"
                        Background="#F5B041" Foreground="#11111B" BorderThickness="0" FontWeight="Bold" Padding="0,6"
                        Cursor="Hand" Click="BtnCompare_Click" Margin="0,0,8,0"/>

                <!-- 导出研报按钮 -->
                <Button Grid.Column="6" Content="📑 导出对比研报 (HTML/PDF)" Width="170"
                        Background="#313244" Foreground="#89B4FA" BorderBrush="#89B4FA" BorderThickness="1"
                        FontWeight="Bold" Padding="0,6" Cursor="Hand" Click="BtnExportReport_Click"/>
            </Grid>
        </Border>

        <!-- 1. ScottPlot 图表区 -->
        <Border Grid.Row="1" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <Grid>
                <sp:WpfPlot x:Name="ComparePlot"/>
                <ProgressBar x:Name="PlotLoading" IsIndeterminate="True" Width="180" Height="6" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Border>

        <!-- 2. 机构量化多维对决 Tab 面板 -->
        <Border Grid.Row="2" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="10,8">
            <TabControl Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Background" Value="#181825"/>
                        <Setter Property="Foreground" Value="#A6ADC8"/>
                        <Setter Property="Padding" Value="14,6"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border Name="Border" Background="{TemplateBinding Background}" CornerRadius="4,4,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="#313244"/>
                                            <Setter Property="Foreground" Value="#F5B041"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>

                <!-- Tab 1: 核心风控指标对决 -->
                <TabItem Header="📊 核心风控与胜率对决">
                    <Grid Margin="0,6,0,0">
                        <DataGrid x:Name="GridMetrics" AutoGenerateColumns="False" IsReadOnly="True"
                                  Background="#181825" Foreground="#FFFFFF" BorderBrush="#313244" RowBackground="#181825"
                                  AlternatingRowBackground="#1E1E2E" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                  HeadersVisibility="Column" FontSize="12">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#313244"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="10,6"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="量化对决指标" Binding="{Binding MetricName}" Width="160" FontWeight="Bold"/>
                                <DataGridTextColumn Header="基金 A 数值" Binding="{Binding ValueA}" Width="130" Foreground="#89B4FA"/>
                                <DataGridTextColumn Header="胜出方 (优势)" Binding="{Binding Winner}" Width="150" FontWeight="Bold" Foreground="#F5B041"/>
                                <DataGridTextColumn Header="基金 B 数值" Binding="{Binding ValueB}" Width="130" Foreground="#F38BA8"/>
                                <DataGridTextColumn Header="指标量化含义与评判标准" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <!-- Tab 2: 五维量化评分横向对决 -->
                <TabItem Header="🏆 五维量化打分 PK">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- 双方总分卡片 -->
                                <RowDefinition Height="Auto"/> <!-- 五维打分表格 -->
                                <RowDefinition Height="Auto"/> <!-- 亮点与风险对决 -->
                            </Grid.RowDefinitions>

                            <!-- 双方综合总分对比卡片 -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#181825" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtScoreHeaderA" Text="[A] 基金 A 量化综合评级" Foreground="#89B4FA" FontWeight="Bold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtOverallScoreA" Text="-- 分" FontSize="22" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,12,0"/>
                                            <Border Background="#313244" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TxtRatingGradeA" Text="评级: --" FontWeight="Bold" Foreground="#A6E3A1" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Grid.Column="1" Text="⚡ 对决 ⚡" FontWeight="Bold" FontSize="13" Foreground="#F5B041" VerticalAlignment="Center" Margin="14,0"/>

                                <Border Grid.Column="2" Background="#181825" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="6" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtScoreHeaderB" Text="[B] 基金 B 量化综合评级" Foreground="#F38BA8" FontWeight="Bold" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TxtOverallScoreB" Text="-- 分" FontSize="22" FontWeight="Bold" Foreground="#F38BA8" Margin="0,0,12,0"/>
                                            <Border Background="#313244" CornerRadius="4" Padding="6,2">
                                                <TextBlock x:Name="TxtRatingGradeB" Text="评级: --" FontWeight="Bold" Foreground="#A6E3A1" FontSize="12"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- 五维量化打分明细表 -->
                            <DataGrid Grid.Row="1" x:Name="GridScoreCardPK" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#181825" Foreground="#FFFFFF" BorderBrush="#313244" RowBackground="#181825"
                                      AlternatingRowBackground="#1E1E2E" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                      HeadersVisibility="Column" FontSize="12" Margin="0,0,0,10">
                                <DataGrid.ColumnHeaderStyle>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#313244"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </Style>
                                </DataGrid.ColumnHeaderStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="评价维度" Binding="{Binding Dimension}" Width="150" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="权重" Binding="{Binding WeightText}" Width="80" Foreground="#A6ADC8"/>
                                    <DataGridTextColumn Header="基金 A 得分" Binding="{Binding ScoreA}" Width="120" Foreground="#89B4FA" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="优势胜出方" Binding="{Binding Winner}" Width="120" Foreground="#F5B041" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="基金 B 得分" Binding="{Binding ScoreB}" Width="120" Foreground="#F38BA8" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="考核重点与量化内涵" Binding="{Binding Description}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 双方亮点与风险点并排比较 -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#181825" CornerRadius="6" Padding="12" BorderBrush="#313244" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🔵 基金 A 亮点与风险诊断" FontWeight="Bold" Foreground="#89B4FA" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtStrengthsA" Text="优势亮点: --" Foreground="#A6E3A1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtWeaknessesA" Text="风险提示: --" Foreground="#F38BA8" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#181825" CornerRadius="6" Padding="12" BorderBrush="#313244" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="🔴 基金 B 亮点与风险诊断" FontWeight="Bold" Foreground="#F38BA8" FontSize="12" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="TxtStrengthsB" Text="优势亮点: --" Foreground="#A6E3A1" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="TxtWeaknessesB" Text="风险提示: --" Foreground="#F38BA8" FontSize="11.5" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Tab 3: 重仓股票重合与申万行业偏离 -->
                <TabItem Header="📦 重仓股票重合与行业偏离">
                    <Grid Margin="0,6,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 重合度概览卡片 -->
                            <RowDefinition Height="*"/>    <!-- 左右双表格: 共同重仓股 VS 行业暴露偏离 -->
                        </Grid.RowDefinitions>

                        <!-- 诊断概览 Banner -->
                        <Border Grid.Row="0" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F38BA8" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                                    <TextBlock x:Name="TxtOverlapBadge" Text="重合度: 0.0%" FontWeight="Bold" Foreground="#11111B" FontSize="11.5"/>
                                </Border>
                                <TextBlock x:Name="TxtOverlapSummary" Text="两只基金持仓穿透计算完成" Foreground="#CDD6F4" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.3*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 左栏: 共同重仓股 -->
                            <Border Grid.Column="0" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="🎯 双方共同重仓股票明细" Foreground="#89B4FA" FontWeight="Bold" FontSize="12" Margin="4,0,0,6"/>
                                    <DataGrid Grid.Row="1" x:Name="GridCommonStocks" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="#181825" Foreground="#FFFFFF" BorderBrush="#313244" RowBackground="#181825"
                                              AlternatingRowBackground="#1E1E2E" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                              HeadersVisibility="Column" FontSize="11.5">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#313244"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="股票名称" Binding="{Binding StockName}" Width="90" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="代码" Binding="{Binding StockCode}" Width="65" Foreground="#A6ADC8"/>
                                            <DataGridTextColumn Header="申万行业" Binding="{Binding Industry}" Width="75"/>
                                            <DataGridTextColumn Header="[A]权重" Binding="{Binding WeightA, StringFormat={}{0:F2}%}" Width="65" Foreground="#89B4FA"/>
                                            <DataGridTextColumn Header="有效重叠" Binding="{Binding OverlapWeight, StringFormat={}{0:F2}%}" Width="68" Foreground="#F5B041" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="[B]权重" Binding="{Binding WeightB, StringFormat={}{0:F2}%}" Width="65" Foreground="#F38BA8"/>
                                            <DataGridTextColumn Header="差额(A-B)" Binding="{Binding WeightDiff, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- 右栏: 申万一级行业偏离 -->
                            <Border Grid.Column="2" Background="#181825" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="🏛️ 申万一级行业配置偏离度" Foreground="#F5B041" FontWeight="Bold" FontSize="12" Margin="4,0,0,6"/>
                                    <DataGrid Grid.Row="1" x:Name="GridIndustrySpread" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="#181825" Foreground="#FFFFFF" BorderBrush="#313244" RowBackground="#181825"
                                              AlternatingRowBackground="#1E1E2E" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                                              HeadersVisibility="Column" FontSize="11.5">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#313244"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Padding" Value="6,4"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="申万行业" Binding="{Binding IndustryName}" Width="85" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="[A]权重" Binding="{Binding WeightA, StringFormat={}{0:F2}%}" Width="65" Foreground="#89B4FA"/>
                                            <DataGridTextColumn Header="[B]权重" Binding="{Binding WeightB, StringFormat={}{0:F2}%}" Width="65" Foreground="#F38BA8"/>
                                            <DataGridTextColumn Header="偏离差额" Binding="{Binding Spread, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="75" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="偏离研判" Binding="{Binding Status}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </TabItem>

                <!-- Tab 4: 盘中实时估值 PK -->
                <TabItem Header="⚡ 盘中实时估值 PK">
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 基金 A 实时估值卡片 -->
                        <Border Grid.Column="0" Background="#181825" BorderBrush="#89B4FA" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="TxtValuationTitleA" Text="[A] 基金 A 盘中估算" Foreground="#89B4FA" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="盘中实时估算净值" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtEstimatedNavA" Text="-- " Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="盘中估算涨跌幅" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtEstimatedGrowthA" Text="--%" Foreground="#A6E3A1" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="最新公布单位净值" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtUnitNavA" Text="-- " Foreground="#CDD6F4" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="最新净值公布日期" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtNavDateA" Text="-- " Foreground="#CDD6F4" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="实时估值时间戳" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtValuationTimeA" Text="-- " Foreground="#F5B041" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 基金 B 实时估值卡片 -->
                        <Border Grid.Column="2" Background="#181825" BorderBrush="#F38BA8" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock x:Name="TxtValuationTitleB" Text="[B] 基金 B 盘中估算" Foreground="#F38BA8" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="盘中实时估算净值" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtEstimatedNavB" Text="-- " Foreground="#FFFFFF" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="盘中估算涨跌幅" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtEstimatedGrowthB" Text="--%" Foreground="#A6E3A1" FontWeight="Bold" FontSize="18" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="最新公布单位净值" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtUnitNavB" Text="-- " Foreground="#CDD6F4" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="最新净值公布日期" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtNavDateB" Text="-- " Foreground="#CDD6F4" FontSize="13" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid>
                                    <TextBlock Text="实时估值时间戳" Foreground="#A6ADC8" FontSize="12"/>
                                    <TextBlock x:Name="TxtValuationTimeB" Text="-- " Foreground="#F5B041" FontSize="12" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
