<UserControl x:Class="BigaFund.Views.AiSimulationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             Background="#11111B" Foreground="#CDD6F4"
             FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18,14">
        <!-- 主界面三层垂直结构：0. 顶部资产仪表盘与操作工具栏；1. 中部时序走势与明细工作台；2. 对话框弹窗浮层 -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0. 顶部资产卡片与工具栏 -->
            <RowDefinition Height="*"/>    <!-- 1. 主工作区 Tab -->
        </Grid.RowDefinitions>

        <!-- 0. 顶部资产统计与操作工具栏 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <!-- 0.1 顶栏操作按钮与标题 -->
            <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#F5B041" CornerRadius="6" Padding="6,4" Margin="0,0,10,0">
                            <TextBlock Text="🤖 AI 实盘演练" FontSize="12" FontWeight="Black" Foreground="#11111B"/>
                        </Border>
                        <TextBlock Text="AI 模拟操盘实战中心" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <TextBlock Text="(100,000 元模拟流动金)" FontSize="13" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>

                    <!-- 右侧操作工具按钮栏 -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnAiAutoBuild" Content="🤖 AI 智能分析建仓 (10万现金)" Background="#F5B041" Foreground="#11111B"
                                FontWeight="Bold" FontSize="12" Padding="12,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnAiAutoBuild_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnManualBuy" Content="🛒 手动自由买入" Background="#89B4FA" Foreground="#11111B"
                                FontWeight="Bold" FontSize="12" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnManualBuy_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnAiDiagnose" Content="⚡ AI 盯盘调仓" Background="#313244" Foreground="#CDD6F4"
                                FontWeight="SemiBold" FontSize="12" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnAiDiagnose_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnRefreshNavs" Content="🔄 刷新最新净值" Background="#313244" Foreground="#CDD6F4"
                                FontWeight="SemiBold" FontSize="12" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" Click="BtnRefreshNavs_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button x:Name="BtnResetAccount" Content="🗑️ 重置账户 (恢复10万)" Background="#181825" Foreground="#F38BA8"
                                BorderBrush="#45475A" FontWeight="SemiBold" FontSize="12" Padding="10,6" Cursor="Hand" Click="BtnResetAccount_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 0.2 核心资产与收益统计卡片 (6 联卡片) -->
            <UniformGrid Columns="6" Margin="0,0,0,4">
                <!-- 卡片 1: 总资产 -->
                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="总资产 (净资产)" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtTotalAsset" Text="¥100,000.00" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="可用现金: " FontSize="10" Foreground="#585B70"/>
                            <TextBlock x:Name="TxtCash" Text="¥100,000.00" FontSize="10" Foreground="#A6E3A1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 2: 累计总收益 -->
                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="累计总收益率" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtTotalProfitRate" Text="+0.00%" FontSize="18" FontWeight="Black" Foreground="#A6E3A1" Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="收益额: " FontSize="10" Foreground="#585B70"/>
                            <TextBlock x:Name="TxtTotalProfit" Text="+¥0.00" FontSize="10" Foreground="#A6E3A1"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 3: 今日参考盈亏 -->
                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="今日参考盈亏" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtTodayProfit" Text="¥0.00" FontSize="18" FontWeight="Black" Foreground="#CDD6F4" Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="今日幅度: " FontSize="10" Foreground="#585B70"/>
                            <TextBlock x:Name="TxtTodayProfitRate" Text="0.00%" FontSize="10" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 4: 仓位比例与市值 -->
                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="股票/基金仓位" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtPositionRatio" Text="0.0%" FontSize="18" FontWeight="Black" Foreground="#89B4FA" Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="持仓市值: " FontSize="10" Foreground="#585B70"/>
                            <TextBlock x:Name="TxtMarketValue" Text="¥0.00" FontSize="10" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 5: 年化与夏普比率 -->
                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="年化收益 / 夏普" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtAnnualizedAndSharpe" Text="0.0% / 0.00" FontSize="17" FontWeight="Bold" Foreground="#F5B041" Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="最大回撤: " FontSize="10" Foreground="#585B70"/>
                            <TextBlock x:Name="TxtMaxDrawdown" Text="0.0%" FontSize="10" Foreground="#F38BA8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 卡片 6: 交易胜率 -->
                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <TextBlock Text="模拟交易胜率" FontSize="11" Foreground="#A6ADC8"/>
                        <TextBlock x:Name="TxtWinRate" Text="0.0%" FontSize="18" FontWeight="Black" Foreground="#A6E3A1" Margin="0,4,0,2"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="已平仓/盈利: " FontSize="10" Foreground="#585B70"/>
                            <TextBlock x:Name="TxtTradeCount" Text="0 / 0 笔" FontSize="10" Foreground="#CDD6F4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>

        <!-- 1. 主工作区 Tab 容器 -->
        <TabControl Grid.Row="1" Background="#181825" BorderBrush="#313244" BorderThickness="1">
            <!-- 1.1 时序收益率走势图 (与基准对标) -->
            <TabItem Header="📈 模拟收益率走势图 (基准对标)">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 时间与基准选择栏 -->
                    <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="时间区间:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <RadioButton x:Name="RbRange1W" Content="近1周" Margin="0,0,8,0" Foreground="#CDD6F4" Click="RbRange_Click"/>
                                <RadioButton x:Name="RbRange1M" Content="近1月" Margin="0,0,8,0" Foreground="#CDD6F4" Click="RbRange_Click"/>
                                <RadioButton x:Name="RbRange3M" Content="近3月" Margin="0,0,8,0" Foreground="#CDD6F4" Click="RbRange_Click"/>
                                <RadioButton x:Name="RbRange6M" Content="近半年" Margin="0,0,8,0" Foreground="#CDD6F4" Click="RbRange_Click"/>
                                <RadioButton x:Name="RbRangeAll" Content="全历程" IsChecked="True" Foreground="#F5B041" FontWeight="Bold" Click="RbRange_Click"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#F5B041" Width="12" Height="3" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="模拟总资产收益率" Foreground="#FFFFFF" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                <Border Background="#89B4FA" Width="12" Height="3" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock Text="沪深300基准指数" Foreground="#89B4FA" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ScottPlot 图表控件 -->
                    <sp:WpfPlot x:Name="PerformancePlot" Grid.Row="1"/>

                    <!-- 图表下方动态分析指标条 -->
                    <Border Grid.Row="2" Background="#1E1E2E" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtPlotSummary" Text="💡 提示：点击顶栏【AI 智能分析建仓】或【手动自由买入】开始模拟交易，系统将每日跟踪资产净值与沪深 300 超额收益。" Foreground="#A6ADC8" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="注：以 10 万元现金建仓为基点，日线复利核算" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 1.2 当前模拟持仓明细 -->
            <TabItem Header="📦 当前模拟持仓明细">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="实时持仓头寸监控 (自动对接公开行情计算最新浮动盈亏与 AI 评级建议)" Foreground="#A6ADC8" VerticalAlignment="Center" FontSize="12"/>
                            <Button Grid.Column="1" Content="➕ 增加新持仓 (买入)" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="8,4" Cursor="Hand" Click="BtnManualBuy_Click"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridPositions" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#181825"
                              Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                              BorderThickness="1" BorderBrush="#313244" HeadersVisibility="Column" SelectionMode="Single">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#11111B"/>
                                <Setter Property="Foreground" Value="#A6ADC8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#313244"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="代码" Binding="{Binding FundCode}" Width="70"/>
                            <DataGridTextColumn Header="基金名称" Binding="{Binding FundName}" Width="160"/>
                            <DataGridTextColumn Header="类别" Binding="{Binding FundType}" Width="90"/>
                            <DataGridTextColumn Header="持仓份额" Binding="{Binding Shares, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="持仓成本" Binding="{Binding CostBasis, StringFormat={}{0:F4}}" Width="85"/>
                            <DataGridTextColumn Header="最新净值" Binding="{Binding LatestNav, StringFormat={}{0:F4}}" Width="85"/>
                            <DataGridTextColumn Header="持仓市值" Binding="{Binding MarketValue, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="浮动盈亏" Binding="{Binding FloatingProfit, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="盈亏率" Binding="{Binding FloatingProfitRate, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="85"/>
                            <DataGridTextColumn Header="仓位占比" Binding="{Binding WeightPercent, StringFormat={}{0:F1}%}" Width="80"/>
                            <DataGridTextColumn Header="AI 量化研判与操作建议" Binding="{Binding AiRecommendation}" Width="*"/>
                            <!-- 交互操作列 -->
                            <DataGridTemplateColumn Header="快速操作" Width="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="➕买入" Margin="0,0,4,0" Padding="6,2" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="BtnPositionBuy_Click" Tag="{Binding FundCode}"/>
                                            <Button Content="➖卖出" Margin="0,0,4,0" Padding="6,2" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" FontSize="11" Cursor="Hand" Click="BtnPositionSell_Click" Tag="{Binding FundCode}"/>
                                            <Button Content="🔍分析" Padding="6,2" Background="#313244" Foreground="#CDD6F4" FontSize="11" Cursor="Hand" Click="BtnPositionDetail_Click" Tag="{Binding FundCode}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 1.3 历史交易流水与决策记录 -->
            <TabItem Header="📜 交易流水与决策依据">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                        <TextBlock Text="全流程交易审计流水：记录每笔 AI 智能操作与手动交易的净值、金额、手续费、实现盈亏及决策条件依据" Foreground="#A6ADC8" FontSize="12"/>
                    </Border>

                    <DataGrid x:Name="GridTrades" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#181825"
                              Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                              BorderThickness="1" BorderBrush="#313244" HeadersVisibility="Column">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#11111B"/>
                                <Setter Property="Foreground" Value="#A6ADC8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#313244"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="成交时间" Binding="{Binding TradeTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="120"/>
                            <DataGridTextColumn Header="基金代码" Binding="{Binding FundCode}" Width="75"/>
                            <DataGridTextColumn Header="基金名称" Binding="{Binding FundName}" Width="150"/>
                            <DataGridTextColumn Header="动作类型" Binding="{Binding ActionText}" Width="110"/>
                            <DataGridTextColumn Header="成交净值" Binding="{Binding Nav, StringFormat={}{0:F4}}" Width="80"/>
                            <DataGridTextColumn Header="成交份额" Binding="{Binding Shares, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="交易金额" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="95"/>
                            <DataGridTextColumn Header="手续费" Binding="{Binding Fee, StringFormat={}{0:N2}}" Width="70"/>
                            <DataGridTextColumn Header="平仓盈亏" Binding="{Binding RealizedProfit, StringFormat={}{0:N2}}" Width="85"/>
                            <DataGridTextColumn Header="平仓收益率" Binding="{Binding RealizedProfitRate, StringFormat={}{0:+0.00;-0.00;0.00}%}" Width="85"/>
                            <DataGridTextColumn Header="各类条件分析与决策依据" Binding="{Binding Reason}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 1.4 AI 多条件选基与备选池 -->
            <TabItem Header="🧠 AI 条件研判与推荐选基池">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1E1E2E" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="AI 多条件选基逻辑架构：" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                            <TextBlock Text="基于【4433 机构选基】+【五维量化评分】+【三年夏普与下行回撤控制】+【大类资产相关性分散】，筛选全市场代表性攻守兼备标的，可随时一键模拟购入。" Foreground="#A6ADC8" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="ItemsCandidates" Grid.Row="1">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Background="#313244" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding RoleTag}" FontWeight="Bold" Foreground="#F5B041" FontSize="11"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FundName}" FontWeight="Bold" Foreground="#FFFFFF" FontSize="13"/>
                                            <TextBlock Text="{Binding FundCode}" Foreground="#89B4FA" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,16,0">
                                            <TextBlock Text="量化综合得分" Foreground="#A6ADC8" FontSize="10"/>
                                            <TextBlock Text="{Binding QuantScore, StringFormat={}{0:F1} 分}" FontWeight="Black" Foreground="#A6E3A1" FontSize="14"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding DetailedRationale}" TextWrapping="Wrap" Foreground="#CDD6F4" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                        <Button Grid.Column="4" Content="🎯 模拟买入" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="12,6" Cursor="Hand" VerticalAlignment="Center" Click="BtnCandidateBuy_Click" Tag="{Binding FundCode}">
                                            <Button.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="6"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- ================= 对话框 / 弹窗浮层 ================= -->

        <!-- 弹窗 1: AI 智能建仓向导 (10万现金) -->
        <Grid x:Name="ModalAiProposal" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed">
            <Border Width="720" Background="#1E1E2E" BorderBrush="#F5B041" BorderThickness="1.5" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="🤖 AI 智能多条件分析 10 万元建仓方案" FontSize="16" FontWeight="Bold" Foreground="#F5B041"/>
                        <TextBlock x:Name="TxtProposalDesc" Text="系统根据 4433 严选、五维量化得分、大类资产配置自动生成的 10 万模拟金建仓草案" Foreground="#A6ADC8" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 风格切换按钮 -->
                    <Border Grid.Row="1" Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="配置策略风格: " Foreground="#FFFFFF" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <RadioButton x:Name="RbStrategyBalanced" Content="🏆 均衡全天候 (推荐)" IsChecked="True" Foreground="#F5B041" FontWeight="Bold" Margin="0,0,12,0" Click="RbStrategy_Click"/>
                            <RadioButton x:Name="RbStrategyGrowth" Content="🚀 进取成长攻势" Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,12,0" Click="RbStrategy_Click"/>
                            <RadioButton x:Name="RbStrategyDefensive" Content="🛡️ 绝对收益防守" Foreground="#A6E3A1" FontWeight="Bold" Click="RbStrategy_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 标的分配表格 -->
                    <DataGrid x:Name="GridProposalItems" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" MaxHeight="280" Background="#181825" RowBackground="#1E1E2E" AlternatingRowBackground="#181825"
                              Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                              BorderThickness="1" BorderBrush="#313244">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="资产角色" Binding="{Binding RoleTag}" Width="100"/>
                            <DataGridTextColumn Header="代码" Binding="{Binding FundCode}" Width="65"/>
                            <DataGridTextColumn Header="基金名称" Binding="{Binding FundName}" Width="150"/>
                            <DataGridTextColumn Header="建议投入金额" Binding="{Binding TargetAmount, StringFormat={}{0:N0} 元}" Width="100"/>
                            <DataGridTextColumn Header="权重" Binding="{Binding WeightPercent, StringFormat={}{0:F0}%}" Width="60"/>
                            <DataGridTextColumn Header="量化得分" Binding="{Binding QuantScore, StringFormat={}{0:F1}}" Width="70"/>
                            <DataGridTextColumn Header="分析依据与通过条件" Binding="{Binding DetailedRationale}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- 底部确认栏 -->
                    <Grid Grid.Row="3" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="注：确认后系统将自动扣减 10 万现金并按上述比例买入建仓" Foreground="#585B70" FontSize="11" VerticalAlignment="Center"/>

                        <Button Grid.Column="1" Content="取消" Width="80" Padding="0,6" Background="#313244" Foreground="#CDD6F4" Margin="0,0,10,0" Cursor="Hand" Click="BtnCloseProposal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="🚀 确认执行 AI 模拟建仓" Padding="14,6" Background="#F5B041" Foreground="#11111B" FontWeight="Bold" Cursor="Hand" Click="BtnConfirmAiBuild_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 弹窗 2: 手动自由买入浮层 -->
        <Grid x:Name="ModalManualBuy" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed">
            <Border Width="480" Background="#1E1E2E" BorderBrush="#89B4FA" BorderThickness="1.5" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="🛒 模拟买入基金 (自由加仓)" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,14"/>

                    <!-- 基金代码与名称 -->
                    <TextBlock Text="基金代码 (如 510300, 000001):" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtBuyFundCode" Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="8,6" FontSize="13" TextChanged="TxtBuyFundCode_TextChanged"/>
                        <TextBlock x:Name="TxtBuyFundNamePreview" Grid.Column="1" Text="华夏成长混合 (最新净值 1.1520)" Foreground="#A6E3A1" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                    </Grid>

                    <!-- 买入金额 -->
                    <TextBlock Text="买入金额 (元):" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBuyAmount" Text="10000" Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="8,6" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- 快捷金额按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="快捷投入: " Foreground="#585B70" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="¥10,000" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickBuyAmount_Click" Tag="10000"/>
                        <Button Content="¥20,000" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickBuyAmount_Click" Tag="20000"/>
                        <Button Content="¥50,000" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickBuyAmount_Click" Tag="50000"/>
                        <Button Content="25%现金" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickBuyRatio_Click" Tag="0.25"/>
                        <Button Content="50%现金" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickBuyRatio_Click" Tag="0.50"/>
                        <Button Content="全部现金" Padding="6,3" Background="#313244" Foreground="#F5B041" FontWeight="Bold" Click="BtnQuickBuyRatio_Click" Tag="1.00"/>
                    </StackPanel>

                    <!-- 买入理由 -->
                    <TextBlock Text="买入理由 / 研判依据 (可选):" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBuyReason" Text="自主量化择时买入建仓" Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="8,6" FontSize="12" Margin="0,0,0,16"/>

                    <!-- 按钮操作 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Padding="0,6" Background="#313244" Foreground="#CDD6F4" Margin="0,0,10,0" Cursor="Hand" Click="BtnCloseBuyModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="确认买入" Width="90" Padding="0,6" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Cursor="Hand" Click="BtnConfirmManualBuy_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 弹窗 3: 手动卖出/赎回浮层 -->
        <Grid x:Name="ModalManualSell" Grid.RowSpan="2" Background="#B0000000" Visibility="Collapsed">
            <Border Width="480" Background="#1E1E2E" BorderBrush="#F38BA8" BorderThickness="1.5" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="💰 模拟赎回卖出基金 (回笼现金)" FontSize="16" FontWeight="Bold" Foreground="#F38BA8" Margin="0,0,0,14"/>

                    <TextBlock x:Name="TxtSellFundInfo" Text="基金: 000001 华夏成长混合 (持有 8,680.55 份，现价 1.1520)" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <TextBlock Text="卖出份额:" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSellShares" Text="1000" Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="8,6" FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

                    <!-- 快捷比例按钮 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="快捷卖出比例: " Foreground="#585B70" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Button Content="25% 份额" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickSellRatio_Click" Tag="0.25"/>
                        <Button Content="50% 份额" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickSellRatio_Click" Tag="0.50"/>
                        <Button Content="75% 份额" Margin="0,0,4,0" Padding="6,3" Background="#313244" Foreground="#CDD6F4" Click="BtnQuickSellRatio_Click" Tag="0.75"/>
                        <Button Content="全部清仓" Padding="6,3" Background="#313244" Foreground="#F38BA8" FontWeight="Bold" Click="BtnQuickSellRatio_Click" Tag="1.00"/>
                    </StackPanel>

                    <!-- 卖出理由 -->
                    <TextBlock Text="卖出理由 (可选):" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtSellReason" Text="达到目标止盈线，分批赎回锁定利润" Background="#181825" Foreground="#FFFFFF" BorderBrush="#45475A" Padding="8,6" FontSize="12" Margin="0,0,0,16"/>

                    <!-- 按钮操作 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Width="80" Padding="0,6" Background="#313244" Foreground="#CDD6F4" Margin="0,0,10,0" Cursor="Hand" Click="BtnCloseSellModal_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="确认卖出" Width="90" Padding="0,6" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" Cursor="Hand" Click="BtnConfirmManualSell_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
